<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Firestore" Version="3.10.0" />
    <!-- REMOVE: <PackageReference Include="Microsoft.WindowsAppSDK" ... /> -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Include sound as Content and copy to bin folder -->
  <Content Include="Assets\Sounds\hoveringOverButton.wav">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Include="Assets\Sounds\completedTask.wav">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Include="Assets\Sounds\creatingTask.wav">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Include="Assets\Sounds\pendingPartnerRequest.wav">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Include="Assets\Sounds\partnerDisconnected.wav">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Include="Assets\Sounds\sent.wav">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <!-- stop SDK default globs from claiming the files as <None> -->
  <None Remove="Assets/Fonts/**" />
  <!-- embed all TTF/OTF fonts as WPF resources -->
  <Resource Include="Assets/Fonts/**/*.ttf" />
  <Resource Include="Assets/Fonts/**/*.otf" />
  <Resource Include="Assets\Icons\app.ico" />
  <PackageReference Include="NAudio" Version="2.2.1" />

  </ItemGroup>
</Project>
