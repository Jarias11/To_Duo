<Window x:Class="TaskMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TaskMate.Views"
        xmlns:conv="clr-namespace:TaskMate.Converters"
        xmlns:local="clr-namespace:TaskMate.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="TaskMate"
        Height="900"
        Width="1000"
        MinWidth="600"
        MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}">
        <Window.Resources>
        </Window.Resources>

        <Grid Margin="10">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- === TOP SECTIONS: Dashboard, Connections, Task Builder === -->
                <views:TopDashboardSection Grid.Row="0"/>



                <!-- TASK LISTS in a big card -->
                <!-- === MIDDLE AREA: one owner ScrollViewer === -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              CanContentScroll="False"
                              PanningMode="VerticalFirst"
                              PanningDeceleration="0.001">
                        <StackPanel>

                                <!-- TASK BOARD (collapsible, default open) -->
                                <Expander Style="{StaticResource CardExpander}"
                                          IsExpanded="True">
                                        <Expander.Header>
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Task Board"
                                                                   Style="{StaticResource SectionHeader}"
                                                                   Margin="0"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="▼"
                                                                   Opacity="0.6"
                                                                   Margin="8,0,0,0"/>
                                                </Grid>
                                        </Expander.Header>

                                        <!-- Card chrome inside the expander -->
                                        <Border Style="{StaticResource Card}">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- ============ MY TASKS (left) ============ -->
                                                        <Border Grid.Column="0"
                                                                Style="{StaticResource SubCard}"
                                                                Background="{DynamicResource SubCardLeftBrush}">
                                                                <!-- shared-size so the 'Due' column aligns across lists -->
                                                                <Grid Grid.IsSharedSizeScope="True">
                                                                        <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <TextBlock Grid.Row="0"
                                                                                   Text="My Tasks"
                                                                                   Style="{StaticResource SectionHeader}"/>

                                                                        <!-- Header: ✓ | Task ......... | Due -->
                                                                        <Grid Grid.Row="1"
                                                                              Background="{DynamicResource HeaderRowBackgroundBrush}"
                                                                              Margin="0,0,0,6">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="30"/>
                                                                                        <!-- checkbox -->
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <!-- title -->
                                                                                        <ColumnDefinition Width="Auto"
                                                                                                          SharedSizeGroup="DueCol"
                                                                                                          MinWidth="90"/>
                                                                                        <!-- due -->
                                                                                </Grid.ColumnDefinitions>

                                                                                <TextBlock Text="✓"
                                                                                           Grid.Column="0"
                                                                                           FontWeight="Bold"/>
                                                                                <TextBlock Text="Task"
                                                                                           Grid.Column="1"
                                                                                           FontWeight="Bold"/>
                                                                                <TextBlock Text="Due"
                                                                                           Grid.Column="2"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Left"
                                                                                           Margin="8,0,0,0"/>
                                                                        </Grid>

                                                                        <!-- Items: two-line template (Title + Due on top; Category below) -->
                                                                        <ItemsControl Grid.Row="2"
                                                                                      ItemsSource="{Binding MyTasksView}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                                <StackPanel/>
                                                                                        </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                                <Button Style="{StaticResource TaskCardButtonStyle}"
                                                                                                        Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                        CommandParameter="{Binding}">
                                                                                                        <Grid>
                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="30"/>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                        <ColumnDefinition Width="Auto"
                                                                                                                                          SharedSizeGroup="DueCol"
                                                                                                                                          MinWidth="110"/>
                                                                                                                </Grid.ColumnDefinitions>
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <!-- Heads-up: until we add a tiny one-liner later, clicking the checkbox will also click the row. -->
                                                                                                                <CheckBox Grid.RowSpan="2"
                                                                                                                          IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                          Margin="2"
                                                                                                                          Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                                          CommandParameter="{Binding}"/>

                                                                                                                <TextBlock Grid.Column="1"
                                                                                                                           Grid.Row="0"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Text="{Binding Title}"
                                                                                                                           Margin="0,0,8,0"
                                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                                           TextWrapping="NoWrap"
                                                                                                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"
                                                                                                                           VerticalAlignment="Center"/>

                                                                                                                <TextBlock Grid.Column="2"
                                                                                                                           Grid.Row="0"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Text="{Binding DueDate, StringFormat={}{0:d}}"
                                                                                                                           HorizontalAlignment="Right"
                                                                                                                           VerticalAlignment="Center"/>

                                                                                                                <TextBlock Grid.Column="1"
                                                                                                                           Grid.Row="1"
                                                                                                                           Grid.ColumnSpan="2"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Opacity="0.8"
                                                                                                                           FontSize="12"
                                                                                                                           Text="{Binding Category}"
                                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                        </Grid>
                                                                                                </Button>

                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                </Grid>
                                                        </Border>

                                                        <!-- ============ PARTNER TASKS (right) ============ -->
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource SubCard}"
                                                                Background="{DynamicResource SubCardRightBrush}"
                                                                Visibility="{Binding ShowPartnerList, Converter={StaticResource BoolToVisibility}}">
                                                                <Grid Grid.IsSharedSizeScope="True">
                                                                        <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <TextBlock Grid.Row="0"
                                                                                   Text="Partner's Tasks"
                                                                                   Style="{StaticResource SectionHeader}"/>

                                                                        <!-- Header: ✓ | Task ......... | Due -->
                                                                        <Grid Grid.Row="1"
                                                                              Background="{DynamicResource HeaderRowBackgroundBrush}"
                                                                              Margin="0,0,0,6">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="30"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"
                                                                                                          SharedSizeGroup="DueCol"
                                                                                                          MinWidth="90"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <TextBlock Text="✓"
                                                                                           Grid.Column="0"
                                                                                           FontWeight="Bold"/>
                                                                                <TextBlock Text="Task"
                                                                                           Grid.Column="1"
                                                                                           FontWeight="Bold"/>
                                                                                <TextBlock Text="Due"
                                                                                           Grid.Column="2"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Left"
                                                                                           Margin="8,0,0,0"/>
                                                                        </Grid>

                                                                        <!-- Items -->
                                                                        <ItemsControl Grid.Row="2"
                                                                                      ItemsSource="{Binding PartnerTasksView}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                                <StackPanel/>
                                                                                        </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                                <Button Style="{StaticResource TaskCardButtonStyle}"
                                                                                                        Visibility="{Binding AssignedTo, Converter={StaticResource AssigneeToVisibilityConverter}, ConverterParameter=Partner}"
                                                                                                        Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                        CommandParameter="{Binding}">
                                                                                                        <Grid>
                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="30"/>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                        <ColumnDefinition Width="Auto"
                                                                                                                                          SharedSizeGroup="DueCol"
                                                                                                                                          MinWidth="110"/>
                                                                                                                </Grid.ColumnDefinitions>
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <CheckBox Grid.RowSpan="2"
                                                                                                                          IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                          Margin="2"
                                                                                                                          Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                                          CommandParameter="{Binding}"/>

                                                                                                                <TextBlock Grid.Column="1"
                                                                                                                           Grid.Row="0"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Text="{Binding Title}"
                                                                                                                           Margin="0,0,8,0"
                                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                                           TextWrapping="NoWrap"
                                                                                                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"
                                                                                                                           VerticalAlignment="Center"/>

                                                                                                                <TextBlock Grid.Column="2"
                                                                                                                           Grid.Row="0"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Text="{Binding DueDate, StringFormat={}{0:d}}"
                                                                                                                           HorizontalAlignment="Right"
                                                                                                                           VerticalAlignment="Center"/>

                                                                                                                <TextBlock Grid.Column="1"
                                                                                                                           Grid.Row="1"
                                                                                                                           Grid.ColumnSpan="2"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Opacity="0.8"
                                                                                                                           FontSize="12"
                                                                                                                           Text="{Binding Category}"
                                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                        </Grid>
                                                                                                </Button>

                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                </Grid>
                                                        </Border>
                                                </Grid>
                                        </Border>
                                </Expander>


                                <!-- COMPLETED TASKS (collapsible) -->
                                <Expander Style="{StaticResource CardExpander}"
                                          Margin="0,10,0,0">
                                        <Expander.Header>
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Completed Tasks"
                                                                   Style="{StaticResource SectionHeader}"
                                                                   Margin="0"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="▼"
                                                                   Opacity="0.6"
                                                                   Margin="8,0,0,0"/>
                                                </Grid>
                                        </Expander.Header>

                                        <Border Style="{StaticResource Card}">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- MY COMPLETED -->
                                                        <Border Grid.Column="0"
                                                                Style="{StaticResource SubCard}"
                                                                Background="{DynamicResource SubCardLeftBrush}">
                                                                <!-- keep 'Completed' column aligned with partner list -->
                                                                <Grid Grid.IsSharedSizeScope="True">
                                                                        <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <TextBlock Grid.Row="0"
                                                                                   Text="My Completed"
                                                                                   Style="{StaticResource SectionHeader}"/>

                                                                        <!-- Header: Task ......... | Completed -->
                                                                        <Grid Grid.Row="1"
                                                                              Background="{DynamicResource HeaderRowBackgroundBrush}"
                                                                              Margin="0,0,0,6">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <!-- title -->
                                                                                        <ColumnDefinition Width="Auto"
                                                                                                          SharedSizeGroup="CompletedCol"
                                                                                                          MinWidth="90"/>
                                                                                        <!-- completed -->
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="Task"
                                                                                           Grid.Column="0"
                                                                                           FontWeight="Bold"/>
                                                                                <TextBlock Text="Completed"
                                                                                           Grid.Column="1"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Left"
                                                                                           Margin="8,0,0,0"/>
                                                                        </Grid>

                                                                        <!-- Items: Title + Completed (top), Category (below) -->
                                                                        <ItemsControl Grid.Row="2"
                                                                                      ItemsSource="{Binding MyCompletedTasks}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                                <Button Style="{StaticResource TaskCardButtonStyle}"
                                                                                                        Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                        CommandParameter="{Binding}">
                                                                                                        <Grid>
                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                        <ColumnDefinition Width="Auto"
                                                                                                                                          SharedSizeGroup="CompletedCol"
                                                                                                                                          MinWidth="90"/>
                                                                                                                </Grid.ColumnDefinitions>
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <TextBlock Grid.Column="0"
                                                                                                                           Grid.Row="0"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Text="{Binding Title}"
                                                                                                                           TextDecorations="Strikethrough"
                                                                                                                           Margin="0,0,8,0"
                                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                                           TextWrapping="NoWrap"
                                                                                                                           VerticalAlignment="Center"/>

                                                                                                                <TextBlock Grid.Column="1"
                                                                                                                           Grid.Row="0"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Text="{Binding CompletedAt, StringFormat={}{0:d}}"
                                                                                                                           HorizontalAlignment="Left"
                                                                                                                           Margin="8,0,0,0"
                                                                                                                           VerticalAlignment="Center"/>

                                                                                                                <TextBlock Grid.Column="0"
                                                                                                                           Grid.Row="1"
                                                                                                                           Grid.ColumnSpan="2"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Opacity="0.8"
                                                                                                                           FontSize="12"
                                                                                                                           Text="{Binding Category}"
                                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                        </Grid>
                                                                                                </Button>
                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                </Grid>
                                                        </Border>

                                                        <!-- PARTNER COMPLETED -->
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource SubCard}"
                                                                Background="{DynamicResource SubCardRightBrush}"
                                                                Visibility="{Binding ShowPartnerList, Converter={StaticResource BoolToVisibility}}">
                                                                <Grid Grid.IsSharedSizeScope="True">
                                                                        <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <TextBlock Grid.Row="0"
                                                                                   Text="Partner's Completed"
                                                                                   Style="{StaticResource SectionHeader}"/>

                                                                        <!-- Header: Task ......... | Completed -->
                                                                        <Grid Grid.Row="1"
                                                                              Background="{DynamicResource HeaderRowBackgroundBrush}"
                                                                              Margin="0,0,0,6">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"
                                                                                                          SharedSizeGroup="CompletedCol"
                                                                                                          MinWidth="90"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="Task"
                                                                                           Grid.Column="0"
                                                                                           FontWeight="Bold"/>
                                                                                <TextBlock Text="Completed"
                                                                                           Grid.Column="1"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Left"
                                                                                           Margin="8,0,0,0"/>
                                                                        </Grid>

                                                                        <!-- Items -->
                                                                        <ItemsControl Grid.Row="2"
                                                                                      ItemsSource="{Binding PartnerCompletedTasks}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                                <Button Style="{StaticResource TaskCardButtonStyle}"
                                                                                                        Visibility="{Binding AssignedTo, Converter={StaticResource AssigneeToVisibilityConverter}, ConverterParameter=Partner}"
                                                                                                        Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                        CommandParameter="{Binding}">
                                                                                                        <Grid>
                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                        <ColumnDefinition Width="Auto"
                                                                                                                                          SharedSizeGroup="CompletedCol"
                                                                                                                                          MinWidth="90"/>
                                                                                                                </Grid.ColumnDefinitions>
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <TextBlock Grid.Column="0"
                                                                                                                           Grid.Row="0"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Text="{Binding Title}"
                                                                                                                           TextDecorations="Strikethrough"
                                                                                                                           Margin="0,0,8,0"
                                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                                           TextWrapping="NoWrap"
                                                                                                                           VerticalAlignment="Center"/>

                                                                                                                <TextBlock Grid.Column="1"
                                                                                                                           Grid.Row="0"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Text="{Binding CompletedAt, StringFormat={}{0:d}}"
                                                                                                                           HorizontalAlignment="Left"
                                                                                                                           Margin="8,0,0,0"
                                                                                                                           VerticalAlignment="Center"/>

                                                                                                                <TextBlock Grid.Column="0"
                                                                                                                           Grid.Row="1"
                                                                                                                           Grid.ColumnSpan="2"
                                                                                                                           Style="{StaticResource TaskRowTextStyle}"
                                                                                                                           Opacity="0.8"
                                                                                                                           FontSize="12"
                                                                                                                           Text="{Binding Category}"
                                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                        </Grid>
                                                                                                </Button>

                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                </Grid>
                                                        </Border>
                                                </Grid>
                                        </Border>
                                </Expander>


                        </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2"
                            Margin="5"
                            Background="#FFFDE7">
                        <TextBlock Text="Pending Partner Tasks"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="5"/>
                        <ItemsControl ItemsSource="{Binding PendingTasks}">
                                <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                                <!-- ✅ Resources must come before any visual content -->
                                                <DataTemplate.Resources>
                                                        <Style x:Key="DecisionBtn"
                                                               TargetType="Button">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanDecide}"
                                                                                     Value="True">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Visible"/>
                                                                        </DataTrigger>
                                                                </Style.Triggers>
                                                        </Style>
                                                </DataTemplate.Resources>

                                                <Border BorderBrush="#E0E0E0"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Margin="5"
                                                        Padding="5"
                                                        Background="White">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Margin="5"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Category}"
                                                                           Margin="5"
                                                                           VerticalAlignment="Center"/>

                                                                <Button Content="Accept"
                                                                        Style="{StaticResource DecisionBtn}"
                                                                        Command="{Binding DataContext.AcceptTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Margin="5"/>

                                                                <Button Content="Decline"
                                                                        Style="{StaticResource DecisionBtn}"
                                                                        Command="{Binding DataContext.DeclineTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Margin="5"/>
                                                        </StackPanel>
                                                </Border>
                                        </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </StackPanel>

                <!-- First-run Welcome Overlay -->
                <Grid Visibility="{Binding NeedsProfileSetup, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Fill="#80000000"/>
                        <Border Background="{DynamicResource OverlayPanelBrush}"
                                Padding="24"
                                CornerRadius="10"
                                Width="400"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <StackPanel>
                                        <TextBlock Text="Welcome to To-Duo"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Enter your name:"
                                                   Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="Continue"
                                                Command="{Binding SaveDisplayNameCommand}"
                                                Margin="0,10,0,0"/>
                                </StackPanel>
                        </Border>
                </Grid>



        </Grid>
</Window>
        