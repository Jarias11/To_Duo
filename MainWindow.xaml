<Window x:Class="TaskMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TaskMate.Views"
        xmlns:conv="clr-namespace:TaskMate.Converters"
        xmlns:local="clr-namespace:TaskMate.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:beh="clr-namespace:TaskMate.Behaviors"
        Title="TaskMate"
        Height="900"
        Width="1000"
        MinWidth="750"
        MinHeight="600"
        Background="{DynamicResource NotebookPaperBrush}">
        <Window.Resources>
        </Window.Resources>

        <Grid Margin="10"
              Background="{x:Null}">




                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- === TOP + MIDDLE: one owner ScrollViewer === -->
                <ScrollViewer Grid.Row="0"
                              Grid.RowSpan="2"
                              VerticalScrollBarVisibility="hidden"
                              CanContentScroll="False"
                              PanningMode="VerticalFirst"
                              PanningDeceleration="0.001"
                              MaxWidth="1500">
                        <StackPanel>

                              <views:TopDashboardSection/> 








                                <!-- TASK BOARD (collapsible, default open) -->
                                <Expander Style="{StaticResource BulletinExpander}"
                                          IsExpanded="True">
                                        <Expander.Header>
                                                <Grid>
                                                        <!-- Title | Stats | (spacer) | Filter -->
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Title centered across the whole header -->
                                                        <TextBlock Grid.ColumnSpan="4"
                                                                   Text="Task Board"
                                                                   Style="{StaticResource SectionHeader}"
                                                                   FontSize="20"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0"/>

                                                        <!-- Tiny stats -->
                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Margin="30,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <!-- Me -->
                                                                <StackPanel Margin="0,0,12,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding MyActiveCount}"
                                                                                   FontSize="15"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource MeTaskTextBrush}"
                                                                                   HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Me"
                                                                                   FontSize="10"
                                                                                   Opacity="0.75"
                                                                                   HorizontalAlignment="Center"/>
                                                                </StackPanel>

                                                                <!-- Partner (only when connected) -->
                                                                <StackPanel Margin="0,0,12,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding ShowPartnerList, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="{Binding PartnerActiveCount}"
                                                                                   FontSize="15"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource PartnerTaskTextBrush}"
                                                                                   HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Partner"
                                                                                   FontSize="10"
                                                                                   Opacity="0.75"
                                                                                   HorizontalAlignment="Center"/>
                                                                </StackPanel>

                                                                <!-- Completed -->
                                                                <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding MyCompletedCount}"
                                                                                   FontSize="15"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource CompletedCountBrush}"
                                                                                   HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Completed"
                                                                                   FontSize="10"
                                                                                   Opacity="0.75"
                                                                                   HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                        </StackPanel>

                                                        <!-- Filter (stays visually the same, now in far-right column) -->
                                                        <StackPanel Grid.Column="3"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="Filter:"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,0,0"
                                                                           Opacity="0.7"/>
                                                                <ComboBox ItemsSource="{Binding SortOptions}"
                                                                          SelectedValuePath="Key"
                                                                          DisplayMemberPath="Value"
                                                                          SelectedValue="{Binding SelectedSort}"
                                                                          MinWidth="130"
                                                                          Margin="4,0,0,0"/>

                                                        </StackPanel>

                                                </Grid>
                                        </Expander.Header>

                                        <!-- Card chrome inside the expander -->

                                        <Grid VerticalAlignment="Top">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Style="{StaticResource PushpinButton}"
                                                        ToolTip="Pop out both lists"
                                                        Command="{Binding PopOutBothCommand}"
                                                        beh:AudioBehavior.HoverSound="True"
                                                        Grid.ColumnSpan="2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-70,0,0"
                                                        Panel.ZIndex="20"/>

                                                <!-- ============ MY TASKS (left) ============ -->
                                                <Border Grid.Column="0"
                                                        Style="{StaticResource SubCard}"
                                                        Background="{DynamicResource SubCardLeftBrush}"
                                                        VerticalAlignment="Top">
                                                        <!-- shared-size so the 'Due' column aligns across lists -->
                                                        <Grid Grid.IsSharedSizeScope="True">
                                                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <StackPanel Grid.Row="0"
                                                                            Orientation="Horizontal">
                                                                        <TextBlock Text="My Tasks"
                                                                                   Style="{StaticResource SectionHeader}"
                                                                                   Margin="0,0,6,0"/>
                                                                </StackPanel>
                                                                <Button Style="{StaticResource PushpinButton}"
                                                                        ToolTip="Pop out My Tasks"
                                                                        Command="{Binding PopOutMineCommand}"
                                                                        beh:AudioBehavior.HoverSound="True"
                                                                        Grid.RowSpan="3"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,-12,0,0"
                                                                        Panel.ZIndex="10"/>


                                                                <!-- Header: ✓ | Task ......... | Due -->
                                                                <Grid Grid.Row="1"
                                                                      Background="{DynamicResource HeaderRowBackgroundBrush}"
                                                                      Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="30"/>
                                                                                <!-- checkbox -->
                                                                                <ColumnDefinition Width="*"/>
                                                                                <!-- title -->
                                                                                <ColumnDefinition Width="Auto"
                                                                                                  SharedSizeGroup="DueCol"
                                                                                                  MinWidth="90"/>
                                                                                <!-- due -->
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Text="✓"
                                                                                   Grid.Column="0"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Task"
                                                                                   Grid.Column="1"
                                                                                   FontWeight="Bold"/>
                                                                        <TextBlock Text="Due"
                                                                                   Grid.Column="2"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Right"
                                                                                   Margin="8,0,0,0"/>
                                                                </Grid>

                                                                <!-- Items: two-line template (Title + Due on top; Category below) -->
                                                                <ItemsControl Grid.Row="2"
                                                                              ItemsSource="{Binding MyTasksView}">
                                                                        <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                        <StackPanel/>
                                                                                </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>

                                                                                        <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="30"/>
                                                                                                        <!-- checkbox -->
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                        <!-- title -->
                                                                                                        <ColumnDefinition Width="Auto"
                                                                                                                          SharedSizeGroup="DueCol"
                                                                                                                          MinWidth="110"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Grid.RowDefinitions>
                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                </Grid.RowDefinitions>

                                                                                                <!-- Checkbox: completes directly -->
                                                                                                <CheckBox Grid.RowSpan="2"
                                                                                                          Style="{StaticResource CircleCheckBox}"
                                                                                                          IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                          Margin="2"
                                                                                                          Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                          CommandParameter="{Binding}"/>

                                                                                                <!-- Title / Due / Category -->
                                                                                                <TextBlock Grid.Column="1"
                                                                                                           Grid.Row="0"
                                                                                                           Style="{StaticResource TaskTitleTextStyle}"
                                                                                                           Text="{Binding Title}"
                                                                                                           Margin="0,0,8,-4"
                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                           TextWrapping="NoWrap"
                                                                                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"
                                                                                                           VerticalAlignment="Center"/>

                                                                                                <TextBlock Grid.Column="2"
                                                                                                           Grid.Row="0"
                                                                                                           Style="{StaticResource TaskDueTextStyle}"
                                                                                                           Text="{Binding DueDate, StringFormat={}{0:d}}"
                                                                                                           HorizontalAlignment="Right"
                                                                                                           VerticalAlignment="Center"/>

                                                                                                <TextBlock Grid.Column="1"
                                                                                                           Grid.Row="1"
                                                                                                           Grid.ColumnSpan="2"
                                                                                                           Style="{StaticResource TaskCategoryTextStyle}"
                                                                                                           Text="{Binding Category}"/>

                                                                                                <!-- Transparent overlay button that starts AFTER the checkbox column -->
                                                                                                <Button Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                        CommandParameter="{Binding}"
                                                                                                        Background="Transparent"
                                                                                                        BorderThickness="0"
                                                                                                        Focusable="False"
                                                                                                        HorizontalAlignment="Stretch"
                                                                                                        VerticalAlignment="Stretch"
                                                                                                        Panel.ZIndex="10"
                                                                                                        Grid.ColumnSpan="3"
                                                                                                        Margin="30,0,0,0"
                                                                                                        Style="{StaticResource TaskCardButtonStyle}"/>
                                                                                        </Grid>


                                                                                </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                        </Grid>
                                                </Border>

                                                <!-- ============ PARTNER TASKS (right) ============ -->
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource SubCard}"
                                                        Background="{DynamicResource SubCardRightBrush}"
                                                        VerticalAlignment="Top"
                                                        Visibility="{Binding ShowPartnerList, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid Grid.IsSharedSizeScope="True">
                                                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <StackPanel Grid.Row="0"
                                                                            Orientation="Horizontal"
                                                                            Visibility="{Binding ShowPartnerList, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="Partner's Tasks"
                                                                                   Style="{StaticResource SectionHeader}"
                                                                                   Margin="0,0,6,0"/>

                                                                </StackPanel>
                                                                <Button Style="{StaticResource PushpinButton}"
                                                                        ToolTip="Pop out Partner Tasks"
                                                                        Command="{Binding PopOutPartnerCommand}"
                                                                        beh:AudioBehavior.HoverSound="True"
                                                                        Grid.RowSpan="3"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,-12,0,0"
                                                                        Panel.ZIndex="10"/>

                                                                <!-- Header: ✓ | Task ......... | Due -->
                                                                <Grid Grid.Row="1"
                                                                      Background="{DynamicResource HeaderRowBackgroundBrush}"
                                                                      Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="30"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"
                                                                                                  SharedSizeGroup="DueCol"
                                                                                                  MinWidth="110"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Text="✓"
                                                                                   Grid.Column="0"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Task"
                                                                                   Grid.Column="1"
                                                                                   FontWeight="Bold"/>
                                                                        <TextBlock Text="Due"
                                                                                   Grid.Column="2"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Right"
                                                                                   Margin="8,0,0,0"/>
                                                                </Grid>

                                                                <!-- Items -->
                                                                <ItemsControl Grid.Row="2"
                                                                              ItemsSource="{Binding PartnerTasksView}">
                                                                        <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                        <StackPanel/>
                                                                                </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                        <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="30"/>
                                                                                                        <!-- checkbox -->
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                        <!-- title -->
                                                                                                        <ColumnDefinition Width="Auto"
                                                                                                                          SharedSizeGroup="DueCol"
                                                                                                                          MinWidth="110"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Grid.RowDefinitions>
                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                </Grid.RowDefinitions>

                                                                                                <!-- Checkbox: completes directly -->
                                                                                                <CheckBox Grid.RowSpan="2"
                                                                                                          Style="{StaticResource CircleCheckBox}"
                                                                                                          IsChecked="{Binding IsCompleted}"
                                                                                                          Margin="2"
                                                                                                          Focusable="False"
                                                                                                          IsHitTestVisible="False"
                                                                                                          ToolTip="Only your partner can complete this"/>

                                                                                                <!-- Title / Due / Category -->
                                                                                                <TextBlock Grid.Column="1"
                                                                                                           Grid.Row="0"
                                                                                                           Style="{StaticResource TaskTitleTextStyle}"
                                                                                                           Text="{Binding Title}"
                                                                                                           Margin="0,0,8,-4"
                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                           TextWrapping="NoWrap"
                                                                                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"
                                                                                                           VerticalAlignment="Center"/>

                                                                                                <TextBlock Grid.Column="2"
                                                                                                           Grid.Row="0"
                                                                                                           Style="{StaticResource TaskDueTextStyle}"
                                                                                                           Text="{Binding DueDate, StringFormat={}{0:d}}"
                                                                                                           HorizontalAlignment="Right"
                                                                                                           VerticalAlignment="Center"/>

                                                                                                <TextBlock Grid.Column="1"
                                                                                                           Grid.Row="1"
                                                                                                           Grid.ColumnSpan="2"
                                                                                                           Style="{StaticResource TaskCategoryTextStyle}"
                                                                                                           Text="{Binding Category}"/>

                                                                                                <!-- Transparent overlay button that starts AFTER the checkbox column -->
                                                                                                <Button Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                        CommandParameter="{Binding}"
                                                                                                        Background="Transparent"
                                                                                                        BorderThickness="0"
                                                                                                        Focusable="False"
                                                                                                        HorizontalAlignment="Stretch"
                                                                                                        VerticalAlignment="Stretch"
                                                                                                        Panel.ZIndex="10"
                                                                                                        Grid.ColumnSpan="3"
                                                                                                        Margin="30,0,0,0"
                                                                                                        Style="{StaticResource TaskCardButtonStyle}"/>
                                                                                        </Grid>
                                                                                </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                        </Grid>
                                                </Border>
                                        </Grid>

                                </Expander>





                        </StackPanel>
                </ScrollViewer>
                <!-- Keep the notebook margin line behind everything -->
                <Rectangle Grid.RowSpan="3"
                           Fill="{DynamicResource NotebookMarginBrush}"
                           Opacity="0.6"
                           Width="2"
                           HorizontalAlignment="Left"
                           Margin="100,0,0,0"
                           IsHitTestVisible="False"
                           Panel.ZIndex="-1"/>



                <!-- First-run Welcome Overlay -->
                <Grid Visibility="{Binding NeedsProfileSetup, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Fill="#80000000"/>
                        <Border Background="{DynamicResource OverlayPanelBrush}"
                                Padding="24"
                                CornerRadius="10"
                                Width="400"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <StackPanel>
                                        <TextBlock Text="Welcome to To-Duo"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Enter your name:"
                                                   Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="Continue"
                                                Command="{Binding SaveDisplayNameCommand}"
                                                Margin="0,10,0,0"
                                                beh:AudioBehavior.HoverSound="True"/>
                                </StackPanel>
                        </Border>
                </Grid>

                <!-- Effects overlay (animations render here). Sits above everything, ignores clicks. -->
                <Canvas x:Name="EffectsLayer"
                        Grid.RowSpan="3"
                        IsHitTestVisible="False"
                        Panel.ZIndex="999"/>

        </Grid>
</Window>
        