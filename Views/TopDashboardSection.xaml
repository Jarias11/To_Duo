<!-- Views/TopDashboardSection.xaml -->
<UserControl x:Class="TaskMate.Views.TopDashboardSection"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:conv="clr-namespace:TaskMate.Converters"
			 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
			 xmlns:views="clr-namespace:TaskMate.Views"
			 xmlns:beh="clr-namespace:TaskMate.Behaviors">


	<StackPanel Grid.Row="0"
				Margin="0,0,0,10">

		<!-- DASHBOARD: open handwritten header (no card) -->
		<Grid Margin="0,6,0,10"
			  Background="Transparent">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<!-- left: time -->
				<ColumnDefinition Width="*"/>
				<!-- center: title -->
				<ColumnDefinition Width="Auto"/>
				<!-- right: buttons -->
			</Grid.ColumnDefinitions>

			<!-- Left: time/date -->
			<TextBlock Grid.Column="0"
					   Style="{StaticResource TopClockText}"
					   Text="{Binding Now, StringFormat={}{0:dddd, MMM d h:mm tt}}"
					   Margin="10,8,12,0"
					   VerticalAlignment="Top"/>

			<!-- Center: title + greeting -->
			<StackPanel Grid.Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Margin="0,0,0,0">

				<TextBlock Text="TaskMate"
						   Style="{StaticResource NotebookTitle}"
						   beh:WriteOnBehavior.Enabled="True"
						   beh:WriteOnBehavior.ShowPenTip="False"
						   beh:WriteOnBehavior.Duration="0:0:3.0"
						   beh:WriteOnBehavior.Delay="0:0:0.0"
						   beh:WriteOnBehavior.PenTipBrush="White"/>

				<!-- Greeting with name -->
				<TextBlock Text="{Binding DisplayName, StringFormat=Welcome back {0}!}"
						   beh:WriteOnBehavior.Enabled="True"
						   beh:WriteOnBehavior.Duration="0:0:1.0"
						   beh:WriteOnBehavior.Delay="0:0:2.5"
						   beh:WriteOnBehavior.PenTipBrush="#222">
					<TextBlock.Style>
						<Style TargetType="TextBlock"
							   BasedOn="{StaticResource NotebookSubtitle}">
							<Setter Property="Visibility"
									Value="Visible"/>
							<Style.Triggers>
								<!-- Hide if profile not set up -->
								<DataTrigger Binding="{Binding NeedsProfileSetup}"
											 Value="True">
									<Setter Property="Visibility"
											Value="Collapsed"/>
								</DataTrigger>
								<!-- Hide if name is empty/null -->
								<DataTrigger Binding="{Binding DisplayName}"
											 Value="">
									<Setter Property="Visibility"
											Value="Collapsed"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding DisplayName}"
											 Value="{x:Null}">
									<Setter Property="Visibility"
											Value="Collapsed"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>

				<!-- Fallback greeting (no name yet) -->
				<TextBlock Text="Welcome back!">
					<TextBlock.Style>
						<Style TargetType="TextBlock"
							   BasedOn="{StaticResource NotebookSubtitle}">
							<Setter Property="Visibility"
									Value="Collapsed"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding NeedsProfileSetup}"
											 Value="True">
									<Setter Property="Visibility"
											Value="Visible"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding DisplayName}"
											 Value="">
									<Setter Property="Visibility"
											Value="Visible"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding DisplayName}"
											 Value="{x:Null}">
									<Setter Property="Visibility"
											Value="Visible"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>

			</StackPanel>

			<!-- Right: floating chip buttons -->
			<StackPanel Grid.Column="2"
						Orientation="Horizontal"
						VerticalAlignment="Top"
						Margin="0,6,0,0">
				<Button Style="{StaticResource IconChipButton}"
						ToolTip="{Binding SoundButtonText}"
						Command="{Binding ToggleSoundCommand}"
						beh:AudioBehavior.HoverSound="True">
					<TextBlock>
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Text"
										Value="🔊"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsMuted}"
												 Value="True">
										<Setter Property="Text"
												Value="🔇"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Button>
				<ToggleButton x:Name="SettingsBtn"
							  Style="{StaticResource IconChipToggleButton}"
							  Content="⚙"
							  ToolTip="Notebook Settings"
							  IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}"
							  beh:AudioBehavior.HoverSound="True"/>
				<Button Style="{StaticResource IconChipButton}"
						ToolTip="{Binding ThemeButtonText}"
						Command="{Binding ToggleThemeCommand}"
						beh:AudioBehavior.HoverSound="True">
					<TextBlock>
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Text"
										Value="☀"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsDarkTheme}"
												 Value="True">
										<Setter Property="Text"
												Value="🌙"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Button>

				<!-- SETTINGS POPUP -->
				<Popup x:Name="SettingsPopup"
					   IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
					   Placement="Custom"
					   PlacementTarget="{Binding ElementName=SettingsBtn}"
					   CustomPopupPlacementCallback="OnPopupPlacement"
					   AllowsTransparency="True"
					   StaysOpen="False"
					   PopupAnimation="Slide">
					<Popup.Resources>
						<Style x:Key="SettingsSwitch"
							   TargetType="ToggleButton">
							<Setter Property="Width"
									Value="48"/>
							<Setter Property="Height"
									Value="24"/>
							<Setter Property="Cursor"
									Value="Hand"/>
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ToggleButton">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition/>
												<ColumnDefinition/>
											</Grid.ColumnDefinitions>

											<!-- track spans both columns -->
											<Border x:Name="Track"
													Grid.ColumnSpan="2"
													CornerRadius="12"
													Background="{DynamicResource TopBarChipBorderBrush}"/>

											<!-- thumb sits in a column we toggle -->
											<Ellipse x:Name="Thumb"
													 Grid.Column="0"
													 Width="20"
													 Height="20"
													 Margin="2"
													 Fill="{DynamicResource ControlBackgroundBrush}"
													 Stroke="{DynamicResource ControlBorderBrush}"/>
										</Grid>

										<ControlTemplate.Triggers>
											<Trigger Property="IsChecked"
													 Value="True">
												<Setter TargetName="Track"
														Property="Background"
														Value="{DynamicResource SuccessButtonBrush}"/>
												<Setter TargetName="Thumb"
														Property="Grid.Column"
														Value="1"/>
											</Trigger>
											<Trigger Property="IsMouseOver"
													 Value="True">
												<Setter TargetName="Track"
														Property="Opacity"
														Value="0.95"/>
											</Trigger>
											<Trigger Property="IsEnabled"
													 Value="False">
												<Setter Property="Opacity"
														Value="0.6"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>

					</Popup.Resources>
					<Border Style="{StaticResource Card}"
							Background="{DynamicResource OverlayPanelBrush}"
							Padding="16"
							CornerRadius="10">
						<StackPanel Width="320">

							<!-- Title + divider -->
							<TextBlock Text="Notebook Settings"
									   Style="{StaticResource NotebookTitle.Sub}"
									   FontSize="20"
									   Margin="2,0,0,6"
									   TextAlignment="Center"/>
							<Border Height="1"
									Margin="0,0,0,10"
									Background="{DynamicResource NotebookRuleBrush}"
									Opacity="0.7"/>

							<!-- Row: Enable Animations -->
							<Border Style="{StaticResource SubCard}"
									Padding="4"
									Margin="0,0,0,8">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0"
											   Text="Enable Animations"
											   Style="{StaticResource NotebookSubtitle}"
											   FontSize="15"
											   FontStyle="Normal"
											   Margin="0,2,0,0"/>
									<ToggleButton Grid.Column="1"
												  Style="{StaticResource SettingsSwitch}"
												  IsChecked="{Binding AnimationsEnabled, Mode=OneWay}"
												  Command="{Binding ToggleAnimationsCommand}"/>
								</Grid>
							</Border>

							<!-- Row: Notifications -->
							<Border Style="{StaticResource SubCard}"
									Padding="4"
									Margin="0,0,0,8">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0"
											   Text="Notifications"
											   Style="{StaticResource NotebookSubtitle}"
											   FontSize="15"
											   FontStyle="Normal"
											   Margin="0,2,0,0"/>
									<ToggleButton Grid.Column="1"
												  Style="{StaticResource SettingsSwitch}"
												  IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"/>
								</Grid>
							</Border>

							<!-- Row: Volume -->
							<Border Style="{StaticResource SubCard}"
									Padding="4">
								<StackPanel>
									<TextBlock Text="{Binding ElementName=VolumeSlider, Path=Value,
                                              StringFormat=Volume: {0:0}%}"
											   Style="{StaticResource NotebookSubtitle}"
											   FontSize="15"
											   FontStyle="Normal"
											   Margin="0,0,0,8"/>
									<Slider x:Name="VolumeSlider"
											Minimum="0"
											Maximum="100"
											Value="50"
											Height="22"
											Foreground="{DynamicResource PrimaryTextBrush}"
											Background="{DynamicResource ControlBackgroundBrush}"/>
								</StackPanel>
							</Border>

						</StackPanel>
					</Border>
				</Popup>
			</StackPanel>
		</Grid>

		<!-- PILL TABS (no title, no card) -->
		<Grid Margin="0,6,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- tabs -->
				<RowDefinition Height="Auto"/>
				<!-- content -->
			</Grid.RowDefinitions>

			<!-- Strip -->
			<TabControl	 x:Name="TopTabs"
						 Grid.Row="0"
						 Style="{StaticResource PillTabs}"
						 ItemContainerStyle="{StaticResource PillTabItem}"
						 SelectedIndex="{Binding SelectedTopTab, Mode=TwoWay}"
						 beh:TabCloseOnDoubleClickBehavior.Enabled="True"
						 HorizontalAlignment="Stretch">
				<TabItem Header="Activity Center"/>
				<TabItem Header="Task Builder"/>
				<TabItem Header="Pending Tasks"/>
				<TabItem Header="Completed"/>
				<TabItem Header="Connections"/>
			</TabControl>

			<!-- CONTENT PANELS (toggle by SelectedTopTab) -->
			<!-- Activity Center (index 0) -->
			<views:ActivityCenterSection Grid.Row="1">
				<views:ActivityCenterSection.Style>
					<Style TargetType="views:ActivityCenterSection">
						<Setter Property="Visibility"
								Value="Collapsed"/>
						<Style.Triggers>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding SelectedTopTab}"
											   Value="0"/>
									<Condition Binding="{Binding ElementName=TopTabs,
                                  Path=(beh:TabCloseOnDoubleClickBehavior.IsCollapsed)}"
											   Value="False"/>
								</MultiDataTrigger.Conditions>
								<Setter Property="Visibility"
										Value="Visible"/>
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</views:ActivityCenterSection.Style>
			</views:ActivityCenterSection>

			<!-- Task Builder (index 1) -->
			<views:TaskBuilderSection Grid.Row="1">
				<views:TaskBuilderSection.Style>
					<Style TargetType="views:TaskBuilderSection">
						<Setter Property="Visibility"
								Value="Collapsed"/>
						<Style.Triggers>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding SelectedTopTab}"
											   Value="1"/>
									<Condition Binding="{Binding ElementName=TopTabs,
                                  Path=(beh:TabCloseOnDoubleClickBehavior.IsCollapsed)}"
											   Value="False"/>
								</MultiDataTrigger.Conditions>
								<Setter Property="Visibility"
										Value="Visible"/>
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</views:TaskBuilderSection.Style>
			</views:TaskBuilderSection>

			<!-- Pending Tasks (index 2) -->
			<views:PendingTasksSection Grid.Row="1">
				<views:PendingTasksSection.Style>
					<Style TargetType="views:PendingTasksSection">
						<Setter Property="Visibility"
								Value="Collapsed"/>
						<Style.Triggers>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding SelectedTopTab}"
											   Value="2"/>
									<Condition Binding="{Binding ElementName=TopTabs,
                                  Path=(beh:TabCloseOnDoubleClickBehavior.IsCollapsed)}"
											   Value="False"/>
								</MultiDataTrigger.Conditions>
								<Setter Property="Visibility"
										Value="Visible"/>
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</views:PendingTasksSection.Style>
			</views:PendingTasksSection>

			<!-- Completed (index 3) -->
			<views:CompletedTasksSection Grid.Row="1">
				<views:CompletedTasksSection.Style>
					<Style TargetType="views:CompletedTasksSection">
						<Setter Property="Visibility"
								Value="Collapsed"/>
						<Style.Triggers>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding SelectedTopTab}"
											   Value="3"/>
									<Condition Binding="{Binding ElementName=TopTabs,
                                  Path=(beh:TabCloseOnDoubleClickBehavior.IsCollapsed)}"
											   Value="False"/>
								</MultiDataTrigger.Conditions>
								<Setter Property="Visibility"
										Value="Visible"/>
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</views:CompletedTasksSection.Style>
			</views:CompletedTasksSection>

			<!-- Connections (index 4) -->
			<views:ConnectionsSection Grid.Row="1">
				<views:ConnectionsSection.Style>
					<Style TargetType="views:ConnectionsSection">
						<Setter Property="Visibility"
								Value="Collapsed"/>
						<Style.Triggers>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding SelectedTopTab}"
											   Value="4"/>
									<Condition Binding="{Binding ElementName=TopTabs,
                                  Path=(beh:TabCloseOnDoubleClickBehavior.IsCollapsed)}"
											   Value="False"/>
								</MultiDataTrigger.Conditions>
								<Setter Property="Visibility"
										Value="Visible"/>
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</views:ConnectionsSection.Style>
			</views:ConnectionsSection>


		</Grid>

	</StackPanel>
</UserControl>