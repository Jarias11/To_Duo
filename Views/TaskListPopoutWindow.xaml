<!-- Views/TaskListPopoutWindow.xaml -->
<Window x:Class="TaskMate.Views.TaskListPopoutWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:beh="clr-namespace:TaskMate.Behaviors"
		xmlns:conv="clr-namespace:TaskMate.Converters"
		xmlns:enums="clr-namespace:TaskMate.Models.Enums"
		Title="Task List"
		Width="420"
		Height="520"
		ResizeMode="CanResize"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ShowInTaskbar="True">

	<!-- OS resize/drag without the heavy chrome look -->
	<WindowChrome.WindowChrome>
		<WindowChrome CaptionHeight="0"
					  CornerRadius="16"
					  ResizeBorderThickness="6"
					  GlassFrameThickness="0"
					  UseAeroCaptionButtons="False"/>
	</WindowChrome.WindowChrome>

	<!-- OUTER: just like a SubCard floating by itself -->
	<Border x:Name="RootCard"
			Padding="12,10,14,12"
			RenderOptions.EdgeMode="Aliased"
			SnapsToDevicePixels="True">
		<Border.Style>
			<Style TargetType="Border"
				   BasedOn="{StaticResource SubCard}">
				<Setter Property="Background"
						Value="{DynamicResource SubCardLeftBrush}"/>
				<Style.Triggers>
					<DataTrigger Binding="{Binding ListKind, RelativeSource={RelativeSource AncestorType=Window}}"
								 Value="{x:Static enums:TaskListKind.Partner}">
						<Setter Property="Background"
								Value="{DynamicResource SubCardRightBrush}"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Border.Style>

		<!-- CONTENT = cloned from each list’s inner layout -->
		<Grid Grid.IsSharedSizeScope="True">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- Title row -->
				<RowDefinition Height="Auto"/>
				<!-- Header ✓ | Task | Due -->
				<RowDefinition Height="*"/>
				<!-- Items -->
			</Grid.RowDefinitions>

			<!-- Title -->
			<StackPanel Grid.Row="0"
						Orientation="Horizontal"
						Margin="0,0,0,2">
				<TextBlock Margin="0,0,6,0">
					<TextBlock.Style>
						<Style TargetType="TextBlock"
							   BasedOn="{StaticResource SectionHeader}">
							<Setter Property="Text"
									Value="My Tasks"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding ListKind, RelativeSource={RelativeSource AncestorType=Window}}"
											 Value="{x:Static enums:TaskListKind.Partner}">
									<Setter Property="Text"
											Value="Partner's Tasks"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>
			<!-- Header row -->
			<Grid Grid.Row="1"
				  Background="{DynamicResource HeaderRowBackgroundBrush}"
				  Margin="0,0,0,6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="30"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"
									  SharedSizeGroup="DueCol"
									  MinWidth="110"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0"
						   Text="✓"
						   FontWeight="Bold"
						   HorizontalAlignment="Center"/>
				<TextBlock Grid.Column="1"
						   Text="Task"
						   FontWeight="Bold"/>
				<TextBlock Grid.Column="2"
						   Text="Due"
						   FontWeight="Bold"
						   HorizontalAlignment="Right"
						   Margin="8,0,0,0"/>
			</Grid>

			<!-- Items: MY TASKS (Mine) -->
			<ItemsControl Grid.Row="2"
						  ItemsSource="{Binding MyTasksView}">
				<ItemsControl.Style>
					<Style TargetType="ItemsControl">
						<Setter Property="Visibility"
								Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding ListKind, RelativeSource={RelativeSource AncestorType=Window}}"
										 Value="{x:Static enums:TaskListKind.Mine}">
								<Setter Property="Visibility"
										Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ItemsControl.Style>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="30"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"
												  SharedSizeGroup="DueCol"
												  MinWidth="110"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<!-- Interactive checkbox (mine) -->
							<CheckBox Grid.RowSpan="2"
									  Style="{StaticResource CircleCheckBox}"
									  IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									  Margin="2"
									  Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
									  CommandParameter="{Binding}"/>

							<TextBlock Grid.Column="1"
									   Grid.Row="0"
									   Style="{StaticResource TaskTitleTextStyle}"
									   Text="{Binding Title}"
									   Margin="0,0,8,-4"
									   TextTrimming="CharacterEllipsis"
									   TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"
									   VerticalAlignment="Center"/>
							<TextBlock Grid.Column="2"
									   Grid.Row="0"
									   Style="{StaticResource TaskDueTextStyle}"
									   Text="{Binding DueDate, StringFormat={}{0:d}}"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1"
									   Grid.Row="1"
									   Grid.ColumnSpan="2"
									   Style="{StaticResource TaskCategoryTextStyle}"
									   Text="{Binding Category}"/>

							<!-- Open details (skips checkbox area via margin) -->
							<Button Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
									CommandParameter="{Binding}"
									Background="Transparent"
									BorderThickness="0"
									Focusable="False"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									Panel.ZIndex="10"
									Grid.ColumnSpan="3"
									Margin="30,0,0,0"
									Style="{StaticResource TaskCardButtonStyle}"/>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Items: PARTNER TASKS (Partner) -->
			<ItemsControl Grid.Row="2"
						  ItemsSource="{Binding PartnerTasksView}">
				<ItemsControl.Style>
					<Style TargetType="ItemsControl">
						<Setter Property="Visibility"
								Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding ListKind, RelativeSource={RelativeSource AncestorType=Window}}"
										 Value="{x:Static enums:TaskListKind.Partner}">
								<Setter Property="Visibility"
										Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ItemsControl.Style>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="30"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"
												  SharedSizeGroup="DueCol"
												  MinWidth="110"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<!-- Read-only checkbox (partner) -->
							<CheckBox Grid.RowSpan="2"
									  Style="{StaticResource CircleCheckBox}"
									  IsChecked="{Binding IsCompleted}"
									  Margin="2"
									  Focusable="False"
									  IsHitTestVisible="False"
									  ToolTip="Only your partner can complete this"/>

							<TextBlock Grid.Column="1"
									   Grid.Row="0"
									   Style="{StaticResource TaskTitleTextStyle}"
									   Text="{Binding Title}"
									   Margin="0,0,8,-4"
									   TextTrimming="CharacterEllipsis"
									   TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"
									   VerticalAlignment="Center"/>
							<TextBlock Grid.Column="2"
									   Grid.Row="0"
									   Style="{StaticResource TaskDueTextStyle}"
									   Text="{Binding DueDate, StringFormat={}{0:d}}"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1"
									   Grid.Row="1"
									   Grid.ColumnSpan="2"
									   Style="{StaticResource TaskCategoryTextStyle}"
									   Text="{Binding Category}"/>

							<Button Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
									CommandParameter="{Binding}"
									Background="Transparent"
									BorderThickness="0"
									Focusable="False"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									Panel.ZIndex="10"
									Grid.ColumnSpan="3"
									Margin="30,0,0,0"
									Style="{StaticResource TaskCardButtonStyle}"/>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Floating pushpin exactly like the board -->
			<Button Grid.RowSpan="3"
					Style="{StaticResource PushpinButton}"
					ToolTip="Keep this pop-out on top"
					Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TogglePinCommand}"
					beh:AudioBehavior.HoverSound="True"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					Margin="0,-12,0,0"
					Panel.ZIndex="20"/>

			<!-- Close (top-right) -->
			<Button Grid.RowSpan="3"
					Style="{StaticResource IconChipButton}"
					ToolTip="Close"
					Content="✕"
					Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseCommand}"
					beh:AudioBehavior.HoverSound="True"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Margin="0,-6,0,0"
					
					Panel.ZIndex="30"/>
		</Grid>
	</Border>

	<!-- Drag to move + ESC to close -->
	<Window.InputBindings>
		<MouseBinding MouseAction="LeftClick"
					  Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StartDragCommand}"/>
		<KeyBinding Key="Escape"
					Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseCommand}"/>
	</Window.InputBindings>
</Window>
