<Window x:Class="TaskMate.Views.TaskBoardPopoutWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Task Board • Pop-out"
		Width="900"
		Height="600"
		Background="{DynamicResource WindowBackgroundBrush}">
	<Border Style="{DynamicResource Card}"
			Margin="10">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>

			<!-- My Tasks (left) -->
			<Border Grid.Column="0"
					Style="{StaticResource SubCard}"
					Background="{DynamicResource SubCardLeftBrush}">
				<Grid Grid.IsSharedSizeScope="True">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0"
							Orientation="Horizontal"
							Margin="0,0,0,6">
						<TextBlock Text="My Tasks"
								Style="{StaticResource SectionHeader}"
								Margin="0,0,8,0"/>
						<TextBlock Text="{Binding MyActiveCount}"
								VerticalAlignment="Center"
								Opacity="0.7"/>
					</StackPanel>

					<!-- Header row -->
					<Grid Grid.Row="1"
							Background="{DynamicResource HeaderRowBackgroundBrush}"
							Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="30"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"
									SharedSizeGroup="DueCol"
									MinWidth="90"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="✓"
								FontWeight="Bold"/>
						<TextBlock Text="Task"
								Grid.Column="1"
								FontWeight="Bold"/>
						<TextBlock Text="Due"
								Grid.Column="2"
								FontWeight="Bold"
								Margin="8,0,0,0"/>
					</Grid>

					<!-- Items -->
					<ScrollViewer Grid.Row="2"
							VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding MyTasksView}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<!-- Reuse your existing button + grid row template -->
									<Button Style="{StaticResource TaskCardButtonStyle}"
											Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
											CommandParameter="{Binding}">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="30"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"
														SharedSizeGroup="DueCol"
														MinWidth="110"/>
											</Grid.ColumnDefinitions>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="Auto"/>
											</Grid.RowDefinitions>

											<CheckBox Grid.RowSpan="2"
													  IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													  Margin="2"
													  Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
													  CommandParameter="{Binding}"/>

											<TextBlock Grid.Column="1"
													   Style="{StaticResource TaskRowTextStyle}"
													   Text="{Binding Title}"
													   Margin="0,0,8,0"
													   TextTrimming="CharacterEllipsis"
													   TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"/>
											<TextBlock Grid.Column="2"
													   Style="{StaticResource TaskRowTextStyle}"
													   Text="{Binding DueDate, StringFormat={}{0:d}}"
													   HorizontalAlignment="Right"/>

											<TextBlock Grid.Column="1"
													Grid.Row="1"
													Grid.ColumnSpan="2"
													   Style="{StaticResource TaskRowTextStyle}"
													Opacity="0.8"
													FontSize="12"
													   Text="{Binding Category}"
													TextTrimming="CharacterEllipsis"/>
										</Grid>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- Partner Tasks (right) -->
			<Border Grid.Column="1"
					Style="{StaticResource SubCard}"
					Background="{DynamicResource SubCardRightBrush}">
				<Grid Grid.IsSharedSizeScope="True">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0"
							Orientation="Horizontal"
							Margin="0,0,0,6">
						<TextBlock Text="Partner's Tasks"
								Style="{StaticResource SectionHeader}"
								Margin="0,0,8,0"/>
						<TextBlock Text="{Binding PartnerActiveCount}"
								VerticalAlignment="Center"
								Opacity="0.7"/>
					</StackPanel>

					<Grid Grid.Row="1"
							Background="{DynamicResource HeaderRowBackgroundBrush}"
							Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="30"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"
									SharedSizeGroup="DueCol"
									MinWidth="90"/>
						</Grid.ColumnDefinitions>
						<TextBlock Text="✓"
								FontWeight="Bold"/>
						<TextBlock Text="Task"
								Grid.Column="1"
								FontWeight="Bold"/>
						<TextBlock Text="Due"
								Grid.Column="2"
								FontWeight="Bold"
								Margin="8,0,0,0"/>
					</Grid>

					<ScrollViewer Grid.Row="2"
							VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding PartnerTasksView}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button Style="{StaticResource TaskCardButtonStyle}"
											Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
											CommandParameter="{Binding}">
										<!-- same row layout as left -->
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="30"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"
														SharedSizeGroup="DueCol"
														MinWidth="110"/>
											</Grid.ColumnDefinitions>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="Auto"/>
											</Grid.RowDefinitions>

											<CheckBox Grid.RowSpan="2"
													  IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													  Margin="2"
													  Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
													  CommandParameter="{Binding}"/>

											<TextBlock Grid.Column="1"
													Style="{StaticResource TaskRowTextStyle}"
													   Text="{Binding Title}"
													Margin="0,0,8,0"
													   TextTrimming="CharacterEllipsis"
													   TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"/>
											<TextBlock Grid.Column="2"
													Style="{StaticResource TaskRowTextStyle}"
													   Text="{Binding DueDate, StringFormat={}{0:d}}"
													   HorizontalAlignment="Right"/>
											<TextBlock Grid.Column="1"
													Grid.Row="1"
													Grid.ColumnSpan="2"
													   Style="{StaticResource TaskRowTextStyle}"
													Opacity="0.8"
													FontSize="12"
													   Text="{Binding Category}"
													TextTrimming="CharacterEllipsis"/>
										</Grid>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>
	</Border>
</Window>
