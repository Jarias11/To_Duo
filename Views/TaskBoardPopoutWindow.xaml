<Window x:Class="TaskMate.Views.TaskBoardPopoutWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:beh="clr-namespace:TaskMate.Behaviors"
		Title="Task Board"
		Width="940"
		Height="680"
		ResizeMode="CanResize"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ShowInTaskbar="True">

	<WindowChrome.WindowChrome>
		<WindowChrome CaptionHeight="0"
					  CornerRadius="16"
					  GlassFrameThickness="0"
					  ResizeBorderThickness="6"
					  UseAeroCaptionButtons="False"/>
	</WindowChrome.WindowChrome>

	<!-- The actual bulletin-paper expander -->
	<Expander x:Name="Bulletin"
			  Style="{StaticResource BulletinExpander}"
			  IsExpanded="True"
			  Focusable="False">

		<!-- === HEADER (identical layout to main) === -->
		<Expander.Header>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Center title -->
				<TextBlock Grid.ColumnSpan="5"
						   Text="Task Board"
						   Style="{StaticResource SectionHeader}"
						   FontSize="20"
						   HorizontalAlignment="Center"/>

				<!-- Tiny stats (left) -->
				<StackPanel Grid.Column="1"
							Orientation="Horizontal"
							Margin="30,0,0,0"
							VerticalAlignment="Center">
					<StackPanel Margin="0,0,12,0"
							VerticalAlignment="Center">
						<TextBlock Text="{Binding MyActiveCount}"
								FontSize="15"
								FontWeight="Bold"
								   Foreground="{DynamicResource MeTaskTextBrush}"
								HorizontalAlignment="Center"/>
						<TextBlock Text="Me"
								FontSize="10"
								Opacity="0.75"
								HorizontalAlignment="Center"/>
					</StackPanel>
					<StackPanel Margin="0,0,12,0"
							VerticalAlignment="Center"
								Visibility="{Binding ShowPartnerList, Converter={StaticResource BoolToVisibility}}">
						<TextBlock Text="{Binding PartnerActiveCount}"
								FontSize="15"
								FontWeight="Bold"
								   Foreground="{DynamicResource PartnerTaskTextBrush}"
								HorizontalAlignment="Center"/>
						<TextBlock Text="Partner"
								FontSize="10"
								Opacity="0.75"
								HorizontalAlignment="Center"/>
					</StackPanel>
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="{Binding MyCompletedCount}"
								FontSize="15"
								FontWeight="Bold"
								   Foreground="{DynamicResource CompletedCountBrush}"
								HorizontalAlignment="Center"/>
						<TextBlock Text="Completed"
								FontSize="10"
								Opacity="0.75"
								HorizontalAlignment="Center"/>
					</StackPanel>
				</StackPanel>

				<!-- Filter (right) -->
				<StackPanel Grid.Column="3"
						Orientation="Horizontal"
						VerticalAlignment="Center">
					<TextBlock Text="Filter:"
							VerticalAlignment="Center"
							Opacity="0.7"/>
					<ComboBox ItemsSource="{Binding SortOptions}"
							  SelectedValuePath="Key"
							DisplayMemberPath="Value"
							  SelectedValue="{Binding SelectedSort}"
							  MinWidth="150"
							Margin="6,0,0,0"/>
				</StackPanel>

				<!-- Pin (top center) -->
				<Button Grid.Column="4"
						Style="{StaticResource PushpinButton}"
						ToolTip="Toggle 'Always on Top'"
						Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TogglePinCommand}"
						beh:AudioBehavior.HoverSound="True"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Margin="0,-12,100,0"
						Panel.ZIndex="10"/>

				<!-- Close (top-right) -->
				<Button Grid.Column="4"
						Style="{StaticResource IconChipButton}"
						ToolTip="Close"
						Content="✕"
						Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseCommand}"
						beh:AudioBehavior.HoverSound="True"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="0,-6,4,0"
						Panel.ZIndex="10"/>
			</Grid>
		</Expander.Header>

		<!-- === CONTENT: two list cards (same as main) === -->
		<ScrollViewer VerticalScrollBarVisibility="Auto"
				CanContentScroll="False">
			<Grid VerticalAlignment="Top">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- My Tasks -->
				<Border Grid.Column="0"
						Style="{StaticResource SubCard}"
						Background="{DynamicResource SubCardLeftBrush}"
						VerticalAlignment="Top"
						Margin="0,0,8,0">
					<Grid Grid.IsSharedSizeScope="True">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0"
								Orientation="Horizontal">
							<TextBlock Text="My Tasks"
									Style="{StaticResource SectionHeader}"
									Margin="0,0,6,0"/>
						</StackPanel>

						<Grid Grid.Row="1"
								Background="{DynamicResource HeaderRowBackgroundBrush}"
								Margin="0,0,0,6">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="30"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"
										SharedSizeGroup="DueCol"
										MinWidth="110"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0"
									Text="✓"
									FontWeight="Bold"
									HorizontalAlignment="Center"/>
							<TextBlock Grid.Column="1"
									Text="Task"
									FontWeight="Bold"/>
							<TextBlock Grid.Column="2"
									Text="Due"
									FontWeight="Bold"
									HorizontalAlignment="Right"
									Margin="8,0,0,0"/>
						</Grid>

						<ItemsControl Grid.Row="2"
								ItemsSource="{Binding MyTasksView}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="30"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"
													SharedSizeGroup="DueCol"
													MinWidth="110"/>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>

										<CheckBox Grid.RowSpan="2"
												  Style="{StaticResource CircleCheckBox}"
												  IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												  Margin="2"
												  Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
												  CommandParameter="{Binding}"/>

										<TextBlock Grid.Column="1"
												Grid.Row="0"
												   Style="{StaticResource TaskTitleTextStyle}"
												   Text="{Binding Title}"
												   Margin="0,0,8,-4"
												   TextTrimming="CharacterEllipsis"
												   TextWrapping="NoWrap"
												   TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"
												   VerticalAlignment="Center"/>
										<TextBlock Grid.Column="2"
												Grid.Row="0"
												   Style="{StaticResource TaskDueTextStyle}"
												   Text="{Binding DueDate, StringFormat={}{0:d}}"
												   HorizontalAlignment="Right"
												VerticalAlignment="Center"/>
										<TextBlock Grid.Column="1"
												Grid.Row="1"
												Grid.ColumnSpan="2"
												   Style="{StaticResource TaskCategoryTextStyle}"
												   Text="{Binding Category}"/>

										<Button Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
												CommandParameter="{Binding}"
												Background="Transparent"
												BorderThickness="0"
												Focusable="False"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Stretch"
												Panel.ZIndex="10"
												Grid.ColumnSpan="3"
												Margin="30,0,0,0"
												Style="{StaticResource TaskCardButtonStyle}"/>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Grid>
				</Border>

				<!-- Partner Tasks -->
				<Border Grid.Column="1"
						Style="{StaticResource SubCard}"
						Background="{DynamicResource SubCardRightBrush}"
						VerticalAlignment="Top"
						Margin="8,0,0,0"
						Visibility="{Binding ShowPartnerList, Converter={StaticResource BoolToVisibility}}">
					<Grid Grid.IsSharedSizeScope="True">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0"
								Orientation="Horizontal">
							<TextBlock Text="Partner's Tasks"
									Style="{StaticResource SectionHeader}"
									Margin="0,0,6,0"/>
						</StackPanel>

						<Grid Grid.Row="1"
								Background="{DynamicResource HeaderRowBackgroundBrush}"
								Margin="0,0,0,6">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="30"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"
										SharedSizeGroup="DueCol"
										MinWidth="110"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0"
									Text="✓"
									FontWeight="Bold"
									HorizontalAlignment="Center"/>
							<TextBlock Grid.Column="1"
									Text="Task"
									FontWeight="Bold"/>
							<TextBlock Grid.Column="2"
									Text="Due"
									FontWeight="Bold"
									HorizontalAlignment="Right"
									Margin="8,0,0,0"/>
						</Grid>

						<ItemsControl Grid.Row="2"
								ItemsSource="{Binding PartnerTasksView}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="30"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"
													SharedSizeGroup="DueCol"
													MinWidth="110"/>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>

										<CheckBox Grid.RowSpan="2"
												Style="{StaticResource CircleCheckBox}"
												  IsChecked="{Binding IsCompleted}"
												  Margin="2"
												Focusable="False"
												IsHitTestVisible="False"
												  ToolTip="Only your partner can complete this"/>

										<TextBlock Grid.Column="1"
												Grid.Row="0"
												   Style="{StaticResource TaskTitleTextStyle}"
												   Text="{Binding Title}"
												   Margin="0,0,8,-4"
												   TextTrimming="CharacterEllipsis"
												   TextWrapping="NoWrap"
												   TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"
												   VerticalAlignment="Center"/>
										<TextBlock Grid.Column="2"
												Grid.Row="0"
												   Style="{StaticResource TaskDueTextStyle}"
												   Text="{Binding DueDate, StringFormat={}{0:d}}"
												   HorizontalAlignment="Right"
												VerticalAlignment="Center"/>
										<TextBlock Grid.Column="1"
												Grid.Row="1"
												Grid.ColumnSpan="2"
												   Style="{StaticResource TaskCategoryTextStyle}"
												   Text="{Binding Category}"/>

										<Button Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
												CommandParameter="{Binding}"
												Background="Transparent"
												BorderThickness="0"
												Focusable="False"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Stretch"
												Panel.ZIndex="10"
												Grid.ColumnSpan="3"
												Margin="30,0,0,0"
												Style="{StaticResource TaskCardButtonStyle}"/>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Grid>
				</Border>
			</Grid>
		</ScrollViewer>
	</Expander>

	<!-- Drag anywhere + quick close -->
	<Window.InputBindings>
		<MouseBinding MouseAction="LeftClick"
					  Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StartDragCommand}"/>
		<KeyBinding Key="Escape"
					Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseCommand}"/>
	</Window.InputBindings>
</Window>
