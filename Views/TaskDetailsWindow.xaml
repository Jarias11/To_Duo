<Window x:Class="TaskMate.Views.TaskDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Details"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        MinWidth="520"
        MinHeight="380"
        MaxWidth="560">

        <Window.Resources>
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

                <!-- ====== Window chrome (accent border by assignee) ====== -->
                <Style x:Key="DialogChrome"
                                TargetType="Border">
                        <Setter Property="CornerRadius"
                                        Value="14"/>
                        <Setter Property="Padding"
                                        Value="0"/>
                        <Setter Property="BorderThickness"
                                        Value="2"/>
                        <Setter Property="BorderBrush"
                                        Value="{DynamicResource MeTaskTextBrush}"/>
                        <Setter Property="SnapsToDevicePixels"
                                        Value="True"/>
                        <Setter Property="Effect">
                                <Setter.Value>
                                        <DropShadowEffect BlurRadius="22"
                                                        ShadowDepth="0"
                                                        Opacity="0.45"/>
                                </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                                <DataTrigger Binding="{Binding Item.AssignedTo}"
                                                Value="Partner">
                                        <Setter Property="BorderBrush"
                                                        Value="{DynamicResource PartnerTaskTextBrush}"/>
                                </DataTrigger>
                        </Style.Triggers>
                </Style>

                <!-- ====== Glass section: dashed box with subtle fill ====== -->
                <Style x:Key="GlassSection"
                                TargetType="ContentControl">
                        <Setter Property="Padding"
                                        Value="10"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ContentControl">
                                                <Grid>
                                                        <!-- slightly stronger for dark theme readability -->
                                                        <Rectangle Fill="{DynamicResource ControlBackgroundBrush}"
                                                                   Opacity="0.16"
                                                                   RadiusX="8"
                                                                        RadiusY="8"/>
                                                        <Rectangle Stroke="{DynamicResource PrimaryTextBrush}"
                                                                   StrokeThickness="1"
                                                                   StrokeDashArray="2,2"
                                                                   Opacity="0.40"
                                                                   RadiusX="8"
                                                                        RadiusY="8"/>
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                </Grid>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- ====== Small info label ====== -->
                <Style x:Key="InfoLabel"
                                TargetType="TextBlock">
                        <Setter Property="FontSize"
                                        Value="12"/>
                        <Setter Property="Opacity"
                                        Value="0.9"/>
                </Style>

                <!-- ====== Assignee chip (theme-safe) ====== -->
                <!-- Chip bg from theme for contrast; text/border use Me/Partner accent -->
                <Style x:Key="AssigneeChip"
                                TargetType="Border">
                        <Setter Property="Padding"
                                        Value="8,3"/>
                        <Setter Property="CornerRadius"
                                        Value="8"/>
                        <Setter Property="Background"
                                        Value="{DynamicResource TopBarChipBackgroundBrush}"/>
                        <Setter Property="BorderBrush"
                                        Value="{DynamicResource TopBarChipBorderBrush}"/>
                        <Setter Property="BorderThickness"
                                        Value="1"/>
                        <Setter Property="SnapsToDevicePixels"
                                        Value="True"/>
                        <Setter Property="TextElement.FontWeight"
                                        Value="SemiBold"/>
                        <Setter Property="TextElement.Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}"/>
                        <Style.Triggers>
                                <DataTrigger Binding="{Binding Item.AssignedTo}"
                                                Value="Me">
                                        <Setter Property="BorderBrush"
                                                        Value="{DynamicResource MeTaskTextBrush}"/>
                                        <Setter Property="TextElement.Foreground"
                                                        Value="{DynamicResource MeTaskTextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Item.AssignedTo}"
                                                Value="Partner">
                                        <Setter Property="BorderBrush"
                                                        Value="{DynamicResource PartnerTaskTextBrush}"/>
                                        <Setter Property="TextElement.Foreground"
                                                        Value="{DynamicResource PartnerTaskTextBrush}"/>
                                </DataTrigger>
                        </Style.Triggers>
                </Style>

                <!-- ====== Round header close button ====== -->
                <Style x:Key="RoundCloseButton"
                                TargetType="Button">
                        <Setter Property="Width"
                                        Value="28"/>
                        <Setter Property="Height"
                                        Value="28"/>
                        <Setter Property="Padding"
                                        Value="0"/>
                        <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="Background"
                                        Value="{DynamicResource TopBarChipBackgroundBrush}"/>
                        <Setter Property="BorderBrush"
                                        Value="{DynamicResource TopBarChipBorderBrush}"/>
                        <Setter Property="BorderThickness"
                                        Value="1"/>
                        <Setter Property="ToolTip"
                                        Value="Close"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        CornerRadius="14"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                        Value="True">
                                                                <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                        Value="True">
                                                                <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource PressedBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                        Value="False">
                                                                <Setter TargetName="Bd"
                                                                                Property="Opacity"
                                                                                Value="0.6"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- ====== Neutral (secondary) button for Close ====== -->
                <Style x:Key="SecondaryButton"
                                TargetType="Button">
                        <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="Background"
                                        Value="{DynamicResource TopBarChipBackgroundBrush}"/>
                        <Setter Property="BorderBrush"
                                        Value="{DynamicResource TopBarChipBorderBrush}"/>
                        <Setter Property="BorderThickness"
                                        Value="1"/>
                        <Setter Property="Padding"
                                        Value="12,6"/>
                        <Setter Property="MinWidth"
                                        Value="90"/>
                        <Setter Property="Height"
                                        Value="32"/>
                        <Setter Property="Cursor"
                                        Value="Hand"/>
                        <Setter Property="FontFamily"
                                        Value="{DynamicResource HandScriptFont}"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        CornerRadius="10"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                        Value="True">
                                                                <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                        Value="True">
                                                                <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource PressedBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                        Value="False">
                                                                <Setter TargetName="Bd"
                                                                                Property="Opacity"
                                                                                Value="0.6"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <!-- SuccessButton & DeclinePillButton come from SharedStyles -->
        </Window.Resources>

        <!-- ====== GLASS BACKDROP + TINT + CONTENT ====== -->
        <Border Style="{StaticResource DialogChrome}">
                <Grid>
                        <!-- Base glass plate -->
                        <Rectangle Fill="{DynamicResource OverlayPanelBrush}"
                                   Opacity="0.92"
                                   RadiusX="12"
                                        RadiusY="12"/>

                        <!-- Assignee tint -->
                        <Rectangle Opacity="0.22"
                                        RadiusX="12"
                                        RadiusY="12">
                                <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                                <Setter Property="Fill"
                                                                Value="{DynamicResource MeTaskTextBrush}"/>
                                                <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Item.AssignedTo}"
                                                                        Value="Partner">
                                                                <Setter Property="Fill"
                                                                                Value="{DynamicResource PartnerTaskTextBrush}"/>
                                                        </DataTrigger>
                                                </Style.Triggers>
                                        </Style>
                                </Rectangle.Style>
                        </Rectangle>

                        <!-- CONTENT -->
                        <Grid Margin="16">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- header -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- underline -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- details -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- notes -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- footer -->
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="📝"
                                                                FontSize="18"
                                                                VerticalAlignment="Center"
                                                                Opacity="0.95"/>
                                                <TextBlock Text="{Binding Item.Title}"
                                                           Margin="8,0,0,0"
                                                           FontFamily="{DynamicResource HandTitleFont}"
                                                           FontSize="28"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                        Value="{DynamicResource MeTaskTextBrush}"/>
                                                                        <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Item.AssignedTo}"
                                                                                                Value="Partner">
                                                                                        <Setter Property="Foreground"
                                                                                                        Value="{DynamicResource PartnerTaskTextBrush}"/>
                                                                                </DataTrigger>
                                                                        </Style.Triggers>
                                                                </Style>
                                                        </TextBlock.Style>
                                                </TextBlock>
                                        </StackPanel>

                                        <!-- Round close button -->
                                        <Button Grid.Column="1"
                                                Content="✕"
                                                Style="{StaticResource RoundCloseButton}"
                                                IsCancel="True"/>
                                </Grid>

                                <!-- underline -->
                                <Border Grid.Row="1"
                                                Height="2"
                                                Margin="4,6,4,12"
                                                CornerRadius="1">
                                        <Border.Background>
                                                <SolidColorBrush Color="White"
                                                                Opacity="0.12"/>
                                        </Border.Background>
                                </Border>

                                <!-- DETAILS -->
                                <ContentControl Grid.Row="2"
                                                Style="{StaticResource GlassSection}"
                                                Margin="0,0,0,10">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Assigned To -->
                                                <TextBlock Grid.Row="0"
                                                                Grid.Column="0"
                                                                Text="Assigned To:"
                                                                Style="{StaticResource InfoLabel}"/>
                                                <Border Grid.Row="0"
                                                                Grid.Column="1"
                                                                Style="{StaticResource AssigneeChip}">
                                                        <TextBlock Text="{Binding Item.AssignedTo}"/>
                                                </Border>

                                                <!-- Category -->
                                                <TextBlock Grid.Row="1"
                                                                Grid.Column="0"
                                                                Text="Category:"
                                                                Style="{StaticResource InfoLabel}"
                                                                Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="1"
                                                                Grid.Column="1"
                                                                Text="{Binding Item.Category, TargetNullValue=—}"
                                                                Margin="0,6,0,0"/>

                                                <!-- Due -->
                                                <TextBlock Grid.Row="2"
                                                                Grid.Column="0"
                                                                Text="Due:"
                                                                Style="{StaticResource InfoLabel}"
                                                                Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="2"
                                                                Grid.Column="1"
                                                                Text="{Binding Item.DueDate, StringFormat={}{0:dddd, MMM d, yyyy}, TargetNullValue=—}"
                                                                Margin="0,6,0,0"/>

                                                <!-- Status -->
                                                <TextBlock Grid.Row="3"
                                                                Grid.Column="0"
                                                                Text="Status:"
                                                                Style="{StaticResource InfoLabel}"
                                                                Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="3"
                                                                Grid.Column="1"
                                                                Margin="0,6,0,0">
                                                        <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                        <Setter Property="Text"
                                                                                        Value="Open"/>
                                                                        <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Item.IsCompleted}"
                                                                                                Value="True">
                                                                                        <Setter Property="Text"
                                                                                                        Value="Completed"/>
                                                                                </DataTrigger>
                                                                        </Style.Triggers>
                                                                </Style>
                                                        </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Completed At -->
                                                <TextBlock Grid.Row="4"
                                                                Grid.Column="0"
                                                           Text="Completed:"
                                                                Margin="0,6,0,0"
                                                           Style="{StaticResource InfoLabel}"
                                                           Visibility="{Binding Item.IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Grid.Row="4"
                                                                Grid.Column="1"
                                                           Margin="0,6,0,0"
                                                           Text="{Binding Item.CompletedAt, StringFormat={}{0:dddd, MMM d, yyyy h:mm tt}}"
                                                           Visibility="{Binding Item.IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                </ContentControl>

                                <!-- NOTES -->
                                <ContentControl Grid.Row="3"
                                                Style="{StaticResource GlassSection}">
                                        <Grid>
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Orientation="Horizontal"
                                                                Grid.Row="0"
                                                                Margin="2,0,0,6"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="📄"
                                                                        Margin="0,0,6,0"/>
                                                        <TextBlock Text="Notes:"
                                                                        FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <ScrollViewer Grid.Row="1"
                                                                Height="160"
                                                                VerticalScrollBarVisibility="Auto"
                                                                HorizontalScrollBarVisibility="Disabled">
                                                        <TextBlock Text="{Binding Item.Description, TargetNullValue=No description}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="4,2,4,2"/>
                                                </ScrollViewer>
                                        </Grid>
                                </ContentControl>

                                <!-- FOOTER -->
                                <StackPanel Grid.Row="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,12,0,0">
                                        <Button Content="Accept"
                                                Width="90"
                                                        Margin="0,0,8,0"
                                                Command="{Binding AcceptCommand}"
                                                Visibility="{Binding CanAccept, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <Button Content="Decline"
                                                Width="90"
                                                        Margin="0,0,16,0"
                                                Command="{Binding DeclineCommand}"
                                                Visibility="{Binding CanDecline, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource DeclinePillButton}"/>

                                        <!-- Complete is hidden when viewing Partner's task -->
                                        <Button Content="Complete"
                                                Width="120"
                                                        Margin="0,0,8,0"
                                                Command="{Binding CompleteCommand}">
                                                <Button.Style>
                                                        <Style TargetType="Button"
                                                                        BasedOn="{StaticResource SuccessButton}">
                                                                <Setter Property="IsEnabled"
                                                                                Value="{Binding CanComplete}"/>
                                                                <Setter Property="Visibility"
                                                                        Value="{Binding CanComplete, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Item.AssignedTo}"
                                                                                        Value="Partner">
                                                                                <Setter Property="Visibility"
                                                                                                Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                </Style.Triggers>
                                                        </Style>
                                                </Button.Style>
                                        </Button>

                                        <!-- Delete is hidden when viewing Partner's task -->
                                        <Button Content="Delete"
                                                Width="90"
                                                        Margin="0,0,16,0"
                                                Command="{Binding DeleteCommand}">
                                                <Button.Style>
                                                        <Style TargetType="Button"
                                                                        BasedOn="{StaticResource DeclinePillButton}">
                                                                <Setter Property="Visibility"
                                                                        Value="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Item.AssignedTo}"
                                                                                        Value="Partner">
                                                                                <Setter Property="Visibility"
                                                                                                Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                </Style.Triggers>
                                                        </Style>
                                                </Button.Style>
                                        </Button>

                                        <Button Content="Close"
                                                Width="90"
                                                IsCancel="True"
                                                Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                        </Grid>
                </Grid>
        </Border>
</Window>
