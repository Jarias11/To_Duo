<Window x:Class="TaskMate.Views.TaskDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Details"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        MinWidth="480"
        MinHeight="340"
        MaxWidth="500">

        <Window.Resources>
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                <!-- Card -->
                <Style x:Key="Card"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="{DynamicResource CardBackgroundBrush}"/>
                        <Setter Property="CornerRadius"
                                Value="10"/>
                        <Setter Property="Padding"
                                Value="16"/>
                        <Setter Property="Margin"
                                Value="0,0,0,12"/>
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource CardBorderBrush}"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Effect">
                                <Setter.Value>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="2"
                                                          Opacity="0.12"/>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Small gray label -->
                <Style x:Key="InfoLabel"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="Opacity"
                                Value="0.8"/>
                </Style>

                <!-- Assignee pill -->
                <Style x:Key="Pill"
                       TargetType="Border">
                        <Setter Property="Padding"
                                Value="6,2"/>
                        <Setter Property="CornerRadius"
                                Value="6"/>
                        <Setter Property="Background"
                                Value="#EEE"/>
                        <Setter Property="BorderBrush"
                                Value="#DDD"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Style.Triggers>
                                <DataTrigger Binding="{Binding Item.AssignedTo}"
                                             Value="Me">
                                        <Setter Property="Background"
                                                Value="#E8F5E9"/>
                                        <Setter Property="BorderBrush"
                                                Value="#C8E6C9"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Item.AssignedTo}"
                                             Value="Partner">
                                        <Setter Property="Background"
                                                Value="#FCE4EC"/>
                                        <Setter Property="BorderBrush"
                                                Value="#F8BBD0"/>
                                </DataTrigger>
                        </Style.Triggers>
                </Style>
        </Window.Resources>

        <Border Style="{StaticResource Card}">
                <StackPanel>

                        <!-- Title -->
                        <TextBlock Text="{Binding Item.Title}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <!-- Facts -->
                        <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Assigned To -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Assigned To:"
                                           Style="{StaticResource InfoLabel}"/>
                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding Item.AssignedTo}"/>
                                </Border>

                                <!-- Category -->
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Category:"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Item.Category, TargetNullValue=—}"
                                           Margin="0,6,0,0"/>

                                <!-- Due -->
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Due:"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding Item.DueDate, StringFormat={}{0:dddd, MMM d, yyyy}, TargetNullValue=—}"
                                           Margin="0,6,0,0"/>

                                <!-- Status -->
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Status:"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Margin="0,6,0,0">
                                        <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                                Value="Open"/>
                                                        <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Item.IsCompleted}"
                                                                             Value="True">
                                                                        <Setter Property="Text"
                                                                                Value="Completed"/>
                                                                </DataTrigger>
                                                        </Style.Triggers>
                                                </Style>
                                        </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="4"
                                                Grid.Column="0"
                                           Text="Completed:"
                                                Margin="0,6,0,0"
                                           Style="{StaticResource InfoLabel}"
                                           Visibility="{Binding Item.IsCompleted,
                                Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <TextBlock Grid.Row="4"
                                                Grid.Column="1"
                                           Margin="0,6,0,0"
                                           Text="{Binding Item.CompletedAt,
                          StringFormat={}{0:dddd, MMM d, yyyy h:mm tt}}"
                                           Visibility="{Binding Item.IsCompleted,
                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <!-- Description -->
                        <GroupBox Header="Description"
                                  Margin="0,6,0,0">
                                <ScrollViewer Height="150"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding Item.Description, TargetNullValue=No description}"
                                                   TextWrapping="Wrap"
                                                   Margin="6"/>
                                </ScrollViewer>
                        </GroupBox>

                        <!-- Footer actions -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0">
                                <!-- Accept/Decline only when CanDecide -->
                                <Button Content="Accept"
                                        Width="90"
                                        Margin="0,0,8,0"
                                        Command="{Binding AcceptCommand}"
                                        Visibility="{Binding CanAccept, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Content="Decline"
                                        Width="90"
                                        Margin="0,0,16,0"
                                        Command="{Binding DeclineCommand}"
                                        Visibility="{Binding CanDecline, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Complete shows when not pending and not completed -->
                                <Button Content="Complete"
                                        Width="100"
                                        Margin="0,0,8,0"
                                        Command="{Binding CompleteCommand}"
                                        IsEnabled="{Binding CanComplete}"
                                        Visibility="{Binding CanComplete, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Delete shows when not pending decision -->
                                <Button Content="Delete"
                                        Width="90"
                                        Margin="0,0,16,0"
                                        Command="{Binding DeleteCommand}"
                                        Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Button Content="Close"
                                        Width="90"
                                        IsCancel="True"/>
                        </StackPanel>

                </StackPanel>
        </Border>
</Window>
