<!-- Views/TaskBuilderSection.xaml -->
<UserControl x:Class="TaskMate.Views.TaskBuilderSection"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Keep the card centered and non-expanding -->
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>

		<!-- Card wrapper + handwriting font for everything inside -->
		<Border Grid.Column="1"
				Style="{StaticResource SubCard}"
				TextElement.FontFamily="{DynamicResource HandScriptFont}"
				HorizontalAlignment="Center"
				MaxWidth="640">
			<StackPanel>

				<!-- Handwritten header + underline -->
				<TextBlock Text="Create New Task"
						   Style="{StaticResource NotebookTitle.Sub}"
						   
						   Margin="12,4,12,2"/>
				<Border Height="2"
						Margin="12,0,12,12"
						Background="{DynamicResource CardBorderBrush}"/>

				<!-- Vertical stack, centered content -->
				<Grid Margin="4">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<!-- Title -->
						<RowDefinition Height="8"/>
						<RowDefinition Height="Auto"/>
						<!-- Description -->
						<RowDefinition Height="12"/>
						<RowDefinition Height="Auto"/>
						<!-- Category + Due -->
						<RowDefinition Height="12"/>
						<RowDefinition Height="Auto"/>
						<!-- Toggle -->
						<RowDefinition Height="16"/>
						<RowDefinition Height="Auto"/>
						<!-- Button -->
					</Grid.RowDefinitions>

					<!-- Title -->
					<StackPanel Grid.Row="0"
								HorizontalAlignment="Center"
								MinWidth="300"
								Margin="6,2">
						<TextBlock Text="Title"
								Margin="5,0,5,2"
								FontWeight="Bold"/>
						<TextBox Width="420"
								Text="{Binding NewTaskTitle}"/>
					</StackPanel>

					<!-- Description -->
					<StackPanel Grid.Row="2"
								HorizontalAlignment="Center"
								MinWidth="360"
								Margin="6,2">
						<TextBlock Text="Description"
								Margin="5,0,5,2"
								FontWeight="Bold"/>
						<TextBox Width="420"
								 MinHeight="120"
								 AcceptsReturn="True"
								 TextWrapping="Wrap"
								 VerticalScrollBarVisibility="Auto"
								 Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
								 ToolTip="Optional task description"/>
					</StackPanel>

					<!-- Category + Due Date on one row -->
					<Grid Grid.Row="4"
							HorizontalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="16"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0"
								Margin="6,2"
								MinWidth="150">
							<TextBlock Text="Category"
									Margin="5,0,5,2"
									FontWeight="Bold"/>
							<ComboBox Width="150"
									  ItemsSource="{Binding Categories}"
									  SelectedItem="{Binding NewTaskCategory, Mode=TwoWay}"
									  IsEditable="False"/>
						</StackPanel>

						<StackPanel Grid.Column="2"
								Margin="6,2"
								MinWidth="150">
							<TextBlock Text="Due Date"
									Margin="5,0,5,2"
									FontWeight="Bold"/>
							<DatePicker Width="150"
									SelectedDate="{Binding NewTaskDueDate}"/>
						</StackPanel>
					</Grid>

					<!-- (Media Request commented out) -->

					<!-- Assign To toggle -->
					<StackPanel Grid.Row="6"
								Margin="6,2"
								MinWidth="160"
								HorizontalAlignment="Center">
						<TextBlock Text="Assign To"
								Margin="5,0,5,2"
								FontWeight="Bold"/>
						<ToggleButton Style="{StaticResource AssignToSwitch}"
									  FontFamily="{DynamicResource HandScriptFont}"
									  IsChecked="{Binding AssignToPartner, Mode=TwoWay}"
									  IsEnabled="{Binding IsPartnerVerified}"/>
					</StackPanel>

					<!-- Add Task button -->
					<Button Grid.Row="8"
							Content="Add Task"
							Width="160"
							HorizontalAlignment="Center"
							Style="{StaticResource SuccessButton}"
							Command="{Binding AddTaskCommand}"/>
				</Grid>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>