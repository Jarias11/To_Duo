<!-- Views/ConnectionsSection.xaml -->
<UserControl x:Class="TaskMate.Views.ConnectionsSection"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:beh="clr-namespace:TaskMate.Behaviors"
			 Padding="24,0">

	<StackPanel MaxWidth="1000">
		<StackPanel Orientation="Horizontal"
					Margin="0,0,0,2">
			<!-- NEW: Section subtitle -->
			<TextBlock Text="Connections"
					   Style="{StaticResource NotebookTitle.Sub}"
					   Margin="0,0,0,8"/>


		</StackPanel>



		<!-- Single card container with a handwritten title strip -->
		<Border Style="{StaticResource Card}"
				Padding="14"
				Margin="0,6,0,10">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<!-- codes row -->
					<RowDefinition Height="Auto"/>
					<!-- state row (enter / waiting / connected) -->
					<RowDefinition Height="Auto"/>
					<!-- divider -->
					<RowDefinition Height="*"/>
					<!-- requests -->
				</Grid.RowDefinitions>



				<!-- Codes Row -->
				<Grid Grid.Row="0"
					  Margin="0,0,0,6"
					  Grid.IsSharedSizeScope="True">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- LEFT: Your Code -->
					<Grid Grid.Column="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"
											  SharedSizeGroup="ConnLabels"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0"
								   Text="Your Code:"
								   Style="{StaticResource SectionHeader}"
								   VerticalAlignment="Center"
								   Margin="0,0,6,0"/>

						<Grid Grid.Column="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<TextBox x:Name="UserCodeBox"
									 Grid.Column="0"
									 Text="{Binding UserId, Mode=OneWay}"
									 Style="{StaticResource CodeDisplayTextBox}"
									 IsReadOnly="True"/>

							<Button Grid.Column="1"
									Content="Copy"
									Click="CopyUserCode_Click"
									Style="{StaticResource ActivitySendButton}"
									Padding="10,0"
									MinWidth="70"
									Margin="6,0,6,0"/>
						</Grid>
					</Grid>

					<!-- RIGHT: partner code entry OR waiting OR connected summary handled below -->
					<Grid Grid.Column="1">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!-- STATE A: Enter partner code -->
						<Grid x:Name="EnterCodeRow">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"
												  SharedSizeGroup="ConnLabels"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<Grid.Style>
								<Style TargetType="Grid">
									<Setter Property="Visibility"
											Value="Collapsed"/>
									<Style.Triggers>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding IsPartnerVerified}"
														   Value="False"/>
												<Condition Binding="{Binding HasPendingOutgoing}"
														   Value="False"/>
											</MultiDataTrigger.Conditions>
											<Setter Property="Visibility"
													Value="Visible"/>
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</Grid.Style>

							<TextBlock Grid.Column="0"
									   Text="Enter Partner Code:"
									   Style="{StaticResource SectionHeader}"
									   VerticalAlignment="Center"
									   Margin="0,0,8,0"/>

							<TextBox Grid.Column="1"
									 Width="200"
									 Text="{Binding EnteredPartnerCode, UpdateSourceTrigger=PropertyChanged}"
									 HorizontalAlignment="Left"
									 VerticalAlignment="Center"
									 Margin="0,0,6,0"/>

							<Button Grid.Column="2"
									Content="Send Request"
									Command="{Binding SendPartnerRequestCommand}"
									Style="{StaticResource ActivitySendButton}"
									VerticalAlignment="Center"
									beh:AudioBehavior.HoverSound="True"/>
						</Grid>

						<!-- STATE B: Waiting (Outgoing pending) -->
						<Border x:Name="WaitingRow"
								Grid.Row="0">
							<Border.Style>
								<Style TargetType="Border"
									   BasedOn="{StaticResource PendingInfoCard}">
									<Setter Property="Visibility"
											Value="Collapsed"/>
									<Style.Triggers>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding IsPartnerVerified}"
														   Value="False"/>
												<Condition Binding="{Binding HasPendingOutgoing}"
														   Value="True"/>
											</MultiDataTrigger.Conditions>
											<Setter Property="Visibility"
													Value="Visible"/>
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>

							<ItemsControl ItemsSource="{Binding OutgoingPartnerRequests}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<Grid.Style>
												<Style TargetType="Grid">
													<Setter Property="Visibility"
															Value="Collapsed"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding Status}"
																	 Value="pending">
															<Setter Property="Visibility"
																	Value="Visible"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Grid.Style>

											<StackPanel Grid.Column="0"
														Orientation="Horizontal"
														VerticalAlignment="Center">
												<Border Style="{StaticResource PendingChip}">
													<TextBlock Text="{Binding ToUserId, StringFormat=Waiting for {0} to accept…}"/>
												</Border>
											</StackPanel>

											<Button Grid.Column="1"
													Content="Cancel Request"
													Command="{Binding DataContext.CancelPartnerRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
													CommandParameter="{Binding}"
													Margin="8,0,0,0"
													beh:AudioBehavior.HoverSound="True"/>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>

						<!-- STATE C: Connected summary -->
						<StackPanel x:Name="ConnectedRow"
									Orientation="Horizontal"
									VerticalAlignment="Center">
							<StackPanel.Style>
								<Style TargetType="StackPanel">
									<Setter Property="Visibility"
											Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsPartnerVerified}"
													 Value="True">
											<Setter Property="Visibility"
													Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</StackPanel.Style>

							<Border Style="{StaticResource InfoChip}">
								<TextBlock Text="{Binding ConnectionSummary}"
										   FontSize="16"/>
							</Border>

							<Button Content="Disconnect"
									Command="{Binding DisconnectPartnerCommand}"
									Margin="8,0,0,0"
									Style="{StaticResource DeclinePillButton}"
									beh:AudioBehavior.HoverSound="True"/>
						</StackPanel>
					</Grid>
				</Grid>

				<!-- Hand-drawn divider -->
				<Rectangle Grid.Row="2"
						   Height="1"
						   Fill="{DynamicResource NotebookRuleBrush}"
						   Opacity="0.6"
						   Margin="0,10,0,10"/>

				<!-- Requests Row (two columns in the same card) -->
				<Grid Grid.Row="3">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- Incoming -->
					<Border Grid.Column="0"
							Style="{StaticResource SubCard}"
							Background="{DynamicResource ActivityCardBackgroundBrush}">
						<StackPanel>
							<TextBlock Text="Incoming Requests"
									   Style="{StaticResource NotebookSubtitle}"
									   HorizontalAlignment="Left"
									   Margin="0,0,0,6"/>
							<ItemsControl ItemsSource="{Binding IncomingPartnerRequests}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Style="{StaticResource TaskItemCard}"
												Background="{DynamicResource PendingIncomingCardBrush}">
											<DockPanel LastChildFill="False">
												<TextBlock Text="{Binding FromDisplayName}"
														   FontWeight="Bold"
														   Margin="0,0,10,0"
														   VerticalAlignment="Center"/>
												<Button Content="Accept"
														Command="{Binding DataContext.AcceptPartnerInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
														CommandParameter="{Binding}"
														Style="{StaticResource SuccessButton}"
														beh:AudioBehavior.HoverSound="True"/>
												<Button Content="Decline"
														Command="{Binding DataContext.DeclinePartnerInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
														CommandParameter="{Binding}"
														Margin="6,0,0,0"
														Style="{StaticResource DeclinePillButton}"
														beh:AudioBehavior.HoverSound="True"/>
											</DockPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<!-- Outgoing -->
					<Border Grid.Column="1"
							Style="{StaticResource SubCard}"
							Background="{DynamicResource ActivityCardBackgroundBrush}">
						<StackPanel>
							<TextBlock Text="Outgoing Requests"
									   Style="{StaticResource NotebookSubtitle}"
									   HorizontalAlignment="Left"
									   Margin="0,0,0,6"/>
							<ItemsControl ItemsSource="{Binding OutgoingPartnerRequests}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Style="{StaticResource TaskItemCard}"
												Background="{DynamicResource PendingSentCardBrush}">
											<DockPanel LastChildFill="False">
												<TextBlock Text="{Binding ToUserId}"
														   FontWeight="Bold"
														   Margin="0,0,10,0"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding Status}"
														   Opacity="0.8"
														   Margin="0,0,10,0"
														   VerticalAlignment="Center"/>
												<Button Content="Cancel"
														Command="{Binding DataContext.CancelPartnerRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
														CommandParameter="{Binding}"
														Style="{StaticResource DeclinePillButton}"
														beh:AudioBehavior.HoverSound="True"/>
											</DockPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</Grid>
			</Grid>
		</Border>
	</StackPanel>
</UserControl>
