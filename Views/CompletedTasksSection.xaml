<UserControl x:Class="TaskMate.Views.CompletedTasksSection"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:enums="clr-namespace:TaskMate.Models.Enums">

	<UserControl.Resources>
		<!-- Note sizing -->
		<sys:Double x:Key="NoteWidth">320</sys:Double>
		<sys:Double x:Key="NoteGap">16</sys:Double>
		<!-- 8px on each side -->
		<sys:Double x:Key="NoteSlotWidth">336</sys:Double>
		<!-- NoteWidth + NoteGap*1 (left+right) -->
		<sys:Double x:Key="NoteMinHeight">150</sys:Double>
		<sys:Double x:Key="TapeWidth">88</sys:Double>
		<!-- narrower -->
		<sys:Double x:Key="TapeHeight">28</sys:Double>
		<!-- taller -->
		<!-- Wrap items like a scrapbook grid -->
		<ItemsPanelTemplate x:Key="WrapItems">
			<WrapPanel ItemWidth="{StaticResource NoteSlotWidth}"
					   Orientation="Horizontal"
					   HorizontalAlignment="Center"
					   IsItemsHost="True"/>
		</ItemsPanelTemplate>
		<!-- Semi-transparent tape brush with soft vertical gradient -->
		<LinearGradientBrush x:Key="TapeBrush"
							 StartPoint="0,0"
							 EndPoint="0,1">
			<!-- light blue w/ alpha for a Scotch-tape vibe -->
			<GradientStop Color="#66BBD7FF"
						  Offset="0.0"/>
			<GradientStop Color="#55BBD7FF"
						  Offset="0.5"/>
			<GradientStop Color="#66BBD7FF"
						  Offset="1.0"/>
		</LinearGradientBrush>


		<!-- Container gets small alternating tilts -->
		<Style x:Key="NoteContainerStyle"
			   TargetType="ContentPresenter">
			<Setter Property="Margin"
					Value="0"/>
			<Setter Property="SnapsToDevicePixels"
					Value="True"/>
			<Setter Property="RenderTransformOrigin"
					Value="0.5,0.5"/>

			<Setter Property="RenderTransform">
				<Setter.Value>
					<RotateTransform Angle="0"/>
				</Setter.Value>
			</Setter>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect BlurRadius="10"
									  ShadowDepth="2"
									  Opacity="0.18"/>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="ItemsControl.AlternationIndex"
						 Value="0">
					<Setter Property="RenderTransform">
						<Setter.Value>
							<RotateTransform Angle="-1.2"/>
						</Setter.Value>
					</Setter>
				</Trigger>
				<Trigger Property="ItemsControl.AlternationIndex"
						 Value="1">
					<Setter Property="RenderTransform">
						<Setter.Value>
							<RotateTransform Angle="0.7"/>
						</Setter.Value>
					</Setter>
				</Trigger>
				<Trigger Property="ItemsControl.AlternationIndex"
						 Value="2">
					<Setter Property="RenderTransform">
						<Setter.Value>
							<RotateTransform Angle="-0.6"/>
						</Setter.Value>
					</Setter>
				</Trigger>
				<Trigger Property="ItemsControl.AlternationIndex"
						 Value="3">
					<Setter Property="RenderTransform">
						<Setter.Value>
							<RotateTransform Angle="1.0"/>
						</Setter.Value>
					</Setter>
				</Trigger>
			</Style.Triggers>
		</Style>
		<!-- Flat button: no hover/pressed/focus visuals -->
		<Style x:Key="CardButtonNoHover"
			   TargetType="Button">
			<Setter Property="Background"
					Value="Transparent"/>
			<Setter Property="BorderThickness"
					Value="0"/>
			<Setter Property="Padding"
					Value="0"/>
			<Setter Property="Cursor"
					Value="Hand"/>
			<Setter Property="Focusable"
					Value="False"/>
			<Setter Property="OverridesDefaultStyle"
					Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<ContentPresenter/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Flat toggle for the Expander header: no blue bg on hover/checked -->
		<Style x:Key="FlatExpanderHeader"
			   TargetType="ToggleButton">
			<Setter Property="Focusable"
					Value="False"/>
			<Setter Property="Background"
					Value="Transparent"/>
			<Setter Property="BorderThickness"
					Value="0"/>
			<Setter Property="Padding"
					Value="12,6"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<!-- No background/hover/pressed visuals at all -->
						<ContentPresenter/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Frameless expander -->
		<Style x:Key="BareBulletinExpander"
			   TargetType="Expander">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Expander">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<!-- Header (now flat) -->
							<ToggleButton x:Name="HeaderSite"
										  Style="{StaticResource FlatExpanderHeader}"
										  Content="{TemplateBinding Header}"
										  IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}"/>

							<!-- Body -->
							<ContentPresenter x:Name="ExpandSite"
											  Grid.Row="1"
											  Margin="0,10,0,0"
											  Visibility="Collapsed"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger SourceName="HeaderSite"
									 Property="IsChecked"
									 Value="True">
								<Setter TargetName="ExpandSite"
										Property="Visibility"
										Value="Visible"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- NOTE CARD (clickable) -->
		<DataTemplate x:Key="NoteTemplate">
			<Button  Style="{StaticResource CardButtonNoHover}"
					 Command="{Binding DataContext.ShowTaskDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
					 CommandParameter="{Binding}">
				<Grid Width="{StaticResource NoteWidth}"
					  MinHeight="{StaticResource NoteMinHeight}"
					  HorizontalAlignment="Center"
					  Margin="0,0,0,12">
					<!-- paper -->
					<Border CornerRadius="10"
							Background="{DynamicResource CardBackgroundBrush}"
							BorderBrush="{DynamicResource CardBorderBrush}"
							BorderThickness="1"
							Padding="14,16,14,12">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<!-- Title -->
							<TextBlock Grid.Row="0"
									   Text="{Binding Title}"
									   Style="{StaticResource TaskTitleTextStyle}"
									   TextDecorations="Strikethrough"
									   Margin="0,2,56,8"
									   TextWrapping="Wrap"
									   TextTrimming="CharacterEllipsis"/>

							<!-- Description preview -->
							<TextBlock Grid.Row="1"
									   Text="{Binding Description}"
									   Foreground="{DynamicResource MutedTextBrush}"
									   FontSize="12"
									   Opacity="0.75"
									   TextWrapping="Wrap"
									   MaxHeight="44"
									   TextTrimming="CharacterEllipsis"/>

							<!-- Footer: who + category + date -->
							<Grid Grid.Row="2"
								  Margin="0,10,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Orientation="Horizontal"
											VerticalAlignment="Center">
									<!-- Who -->
									<Border Background="{DynamicResource TopBarChipBackgroundBrush}"
											BorderBrush="{DynamicResource TopBarChipBorderBrush}"
											BorderThickness="1"
											CornerRadius="10"
											Padding="6,1.5"
											VerticalAlignment="Center">
										<TextBlock FontFamily="{DynamicResource HandScriptFont}"
												   FontSize="14"
												   Foreground="{DynamicResource PrimaryTextBrush}">
											<TextBlock.Text>
												<MultiBinding StringFormat="{}{0}">
													<Binding Path="AssignedTo"/>
												</MultiBinding>
											</TextBlock.Text>
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Text"
															Value="You"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding AssignedTo}"
																	 Value="{x:Static enums:Assignee.Partner}">
															<Setter Property="Text"
																	Value="Partner"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Border>

									<!-- Category chip (if any) -->
									<Border Background="{DynamicResource CategoryChipBackgroundBrush}"
											BorderBrush="{DynamicResource CategoryChipBorderBrush}"
											BorderThickness="1"
											CornerRadius="10"
											Padding="6,1.5"
											Margin="6,0,0,0"
											VerticalAlignment="Center"
											Visibility="{Binding Category, Converter={StaticResource NullToCollapsedConverter}}">
										<TextBlock FontFamily="{DynamicResource HandScriptFont}"
												   FontSize="14"
												   Text="{Binding Category}"/>
									</Border>
								</StackPanel>

								<!-- Completed date -->
								<TextBlock Grid.Column="1"
										   Style="{StaticResource TaskDueTextStyle}"
										   Text="{Binding CompletedAt, StringFormat={}{0:MMM d, yyyy}}"
										   VerticalAlignment="Center"/>
							</Grid>
						</Grid>
					</Border>

					<!-- blue tape -->
					<Border
						Width="{StaticResource TapeWidth}"
						Height="{StaticResource TapeHeight}"
						Background="{StaticResource TapeBrush}"
						CornerRadius="3"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Margin="0,-12,0,0"
						BorderBrush="#30FFFFFF"
						BorderThickness="1">
						<!-- slight rotate like it’s stuck on -->
						<Border.RenderTransform>
							<RotateTransform Angle="-6"/>
						</Border.RenderTransform>

						<!-- fade the left/right edges so it looks torn/feathered -->
						<Border.OpacityMask>
							<LinearGradientBrush StartPoint="0,0"
												 EndPoint="1,0">
								<GradientStop Color="#00FFFFFF"
											  Offset="0.00"/>
								<GradientStop Color="#FFFFFFFF"
											  Offset="0.08"/>
								<GradientStop Color="#FFFFFFFF"
											  Offset="0.92"/>
								<GradientStop Color="#00FFFFFF"
											  Offset="1.00"/>
							</LinearGradientBrush>
						</Border.OpacityMask>

						<!-- very soft shadow (tape shouldn’t cast much) -->
						<Border.Effect>
							<DropShadowEffect BlurRadius="3"
											  ShadowDepth="1"
											  Opacity="0.12"/>
						</Border.Effect>
					</Border>

					<!-- “Done” stamp -->
					<Grid HorizontalAlignment="Right"
						  VerticalAlignment="Top"
						  Margin="0,6,8,0">
						<Ellipse Width="56"
								 Height="36"
								 Fill="{DynamicResource SuccessButtonBrush}"
								 Stroke="{DynamicResource SuccessButtonBorderBrush}"
								 StrokeThickness="1.2"
								 Opacity="0.95">
							<Ellipse.RenderTransform>
								<RotateTransform Angle="8"/>
							</Ellipse.RenderTransform>
							<Ellipse.Effect>
								<DropShadowEffect BlurRadius="4"
												  ShadowDepth="1"
												  Opacity="0.25"/>
							</Ellipse.Effect>
						</Ellipse>
						<TextBlock Text="✓ Done"
								   FontFamily="{DynamicResource HandScriptFont}"
								   FontWeight="Bold"
								   FontSize="14"
								   Foreground="White"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Margin="0,2,0,0">
							<TextBlock.RenderTransform>
								<RotateTransform Angle="8"/>
							</TextBlock.RenderTransform>
						</TextBlock>
					</Grid>
				</Grid>
			</Button>
		</DataTemplate>

		<!-- Header -->
		<DataTemplate x:Key="BoardHeaderTemplate">
			<StackPanel Orientation="Horizontal"
					VerticalAlignment="Center"
					Margin="2,4,2,0">
				<TextBlock Text="✔"
						Margin="0,0,8,0"
						VerticalAlignment="Center"
						FontSize="22"/>
				<TextBlock Text="Our Completed Memories"
						   Style="{StaticResource NotebookTitle.Sub}"/>
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>

	<!-- Cork-board container you already theme -->
	<Grid>
		<!-- Background panel under everything -->
		<Border Background="{DynamicResource BoardBackgroundBrush}"
				CornerRadius="12"
				Margin="3"/>

		<!-- The board (frameless, no blue header) -->
		<Expander Style="{StaticResource BareBulletinExpander}"
				  IsExpanded="True">
			<Expander.Header>
				<ContentPresenter ContentTemplate="{StaticResource BoardHeaderTemplate}"/>
			</Expander.Header>

			<Border Padding="12,6,18,12"
					Background="Transparent">
				<ItemsControl x:Name="CompletedBoard"
							  ItemTemplate="{StaticResource NoteTemplate}"
							  ItemsPanel="{StaticResource WrapItems}"
							  ItemContainerStyle="{StaticResource NoteContainerStyle}"
							  AlternationCount="4"
							  ItemsSource="{Binding CompletedAllView}"/>
			</Border>
		</Expander>

		<!-- Dotted outline on top -->
		<Rectangle IsHitTestVisible="False"
				   RadiusX="12"
				   RadiusY="12"
				   Stroke="{DynamicResource BoardOutlineBrush}"
				   StrokeThickness="2"
				   StrokeDashArray="1,2"
				   StrokeDashCap="Round"
				   Fill="Transparent"
				   Margin="3"
				   Panel.ZIndex="10"/>
	</Grid>
</UserControl>
