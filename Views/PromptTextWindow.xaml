<Window x:Class="TaskMate.Views.PromptTextWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Height="180"
		Width="400"
		WindowStartupLocation="CenterOwner"
		ResizeMode="NoResize">
	<StackPanel Margin="16">
		<TextBlock x:Name="MessageText"
				Margin="0,0,0,8"
				TextWrapping="Wrap"/>

		<!-- Watermarked TextBox -->
		<Grid Margin="0,0,0,8">
			<TextBox x:Name="InputBox"
					 Padding="6,4,6,4"
					 MinWidth="260"/>

			<!-- Watermark only visible when TextBox.Text == "" -->
			<TextBlock Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=Window}}"
					   Margin="8,6,0,0"
					   Foreground="#99000000"
					   IsHitTestVisible="False">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility"
								Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding Text, ElementName=InputBox}"
									Value="">
								<Setter Property="Visibility"
										Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</Grid>

		<StackPanel Orientation="Horizontal"
				HorizontalAlignment="Right">
			<Button Content="OK"
					Width="75"
					Margin="0,0,8,0"
					IsDefault="True"
					Click="Ok_Click"/>
			<Button Content="Cancel"
					Width="75"
					IsCancel="True"
					Click="Cancel_Click"/>
		</StackPanel>
	</StackPanel>
</Window>