<!--	SharedStyles.xaml	-->
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:conv="clr-namespace:TaskMate.Converters"
	xmlns:sys="clr-namespace:System;assembly=System.Runtime"
	xmlns:local="clr-namespace:TaskMate.ViewModels">

	<!-- Converters -->
	<BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
	<conv:AssigneeToVisibilityConverter x:Key="AssigneeToVisibilityConverter"/>
	<conv:TupleConverter x:Key="TupleConverter"/>
	<conv:DictionaryLookupConverter x:Key="DictLookup"/>
	<local:BoolToTextDecorationsConverter x:Key="BoolToTextDecorationsConverter"/>


	<!-- Family names must match the internal font family, not the filename -->
	<FontFamily x:Key="HandTitleFont">pack://application:,,,/Assets/Fonts/#Caveat</FontFamily>
	<FontFamily x:Key="HandScriptFont">pack://application:,,,/Assets/Fonts/#Kalam</FontFamily>

	<!-- Brushes -->
	<SolidColorBrush x:Key="MeTaskTextBrush"
					 Color="#4CAF50"/>
	<SolidColorBrush x:Key="PartnerTaskTextBrush"
					 Color="#E91E63"/>
	<SolidColorBrush x:Key="CompletedCountBrush"
					 Color="#616161"/>





	<!-- Treat null/empty string as false; any text as true -->
	<conv:BooleanOrMultiConverter x:Key="BooleanOrMultiConverter"/>
	<conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>





	<!-- Handwritten title + subtitle -->
	<Style x:Key="NotebookTitle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource {x:Type TextBlock}}">
		<Setter Property="FontFamily"
				Value="{DynamicResource HandTitleFont}"/>
		<Setter Property="FontSize"
				Value="60"/>
		<Setter Property="FontWeight"
				Value="SemiBold"/>
		<Setter Property="Foreground"
				Value="{DynamicResource TitleAccentBrush}"/>
		<Setter Property="TextOptions.TextFormattingMode"
				Value="Display"/>
		<Setter Property="TextOptions.TextHintingMode"
				Value="Fixed"/>
		<!-- Soft “chalk” glow for that handwritten pop -->
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect ShadowDepth="0"
								  BlurRadius="1"
								  Opacity="0.65"
								  Color="#403A2E"/>
			</Setter.Value>
		</Setter>
		<Setter Property="Margin"
				Value="0,2,0,2"/>
	</Style>
	<!-- A slightly smaller variant of NotebookTitle for section headings -->
	<Style x:Key="NotebookTitle.Sub"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource NotebookTitle}">

		<Setter Property="FontSize"
				Value="40"/>
		<Setter Property="FontWeight"
				Value="Normal"/>
		<!-- was 60 -->
		<Setter Property="Margin"
				Value="0,0,0,4"/>
		<!-- a hair tighter -->
	</Style>

	<Style x:Key="NotebookSubtitle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource {x:Type TextBlock}}">
		<Setter Property="FontFamily"
				Value="{DynamicResource HandScriptFont}"/>
		<Setter Property="FontSize"
				Value="18"/>
		<Setter Property="FontStyle"
				Value="Italic"/>
		<Setter Property="Foreground"
				Value="{DynamicResource TitleAccentBrush}"/>
		<Setter Property="Opacity"
				Value="0.9"/>
		<Setter Property="HorizontalAlignment"
				Value="Center"/>
	</Style>

	<Style x:Key="TopClockText"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource {x:Type TextBlock}}">
		<Setter Property="FontFamily"
				Value="{DynamicResource HandScriptFont}"/>
		<Setter Property="FontWeight"
				Value="Normal"/>
		<Setter Property="FontStyle"
				Value="Normal"/>
		<Setter Property="FontSize"
				Value="14"/>
		<Setter Property="Foreground"
				Value="{DynamicResource TitleAccentBrush}"/>
		<Setter Property="Opacity"
				Value="0.9"/>
		<Setter Property="TextOptions.TextFormattingMode"
				Value="Display"/>
		<Setter Property="TextOptions.TextHintingMode"
				Value="Fixed"/>
	</Style>

	<!-- Small rounded "chip" buttons -->
	<Style x:Key="IconChipButton"
		   TargetType="Button">
		<Setter Property="Width"
				Value="34"/>
		<Setter Property="Height"
				Value="34"/>
		<Setter Property="Padding"
				Value="0"/>
		<Setter Property="Margin"
				Value="6,0,0,0"/>
		<Setter Property="Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="Background"
				Value="{DynamicResource TopBarChipBackgroundBrush}"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource TopBarChipBorderBrush}"/>
		<Setter Property="BorderThickness"
				Value="1"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Bd"
							CornerRadius="8"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Padding="8">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter TargetName="Bd"
									Property="Background"
									Value="{DynamicResource HoverBrush}"/>
						</Trigger>
						<Trigger Property="IsPressed"
								 Value="True">
							<Setter TargetName="Bd"
									Property="Background"
									Value="{DynamicResource PressedBrush}"/>
						</Trigger>
						<Trigger Property="IsEnabled"
								 Value="False">
							<Setter TargetName="Bd"
									Property="Opacity"
									Value="0.6"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>






	<!-- Pill tab STRIP -->
	<Style x:Key="PillTabs"
		   TargetType="TabControl">
		<Setter Property="Background"
				Value="{DynamicResource TopBarChipBackgroundBrush}"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource TopBarChipBorderBrush}"/>
		<Setter Property="BorderThickness"
				Value="1"/>
		<!-- breathing room + guaranteed inner height -->
		<Setter Property="Padding"
				Value="0"/>
		<Setter Property="MinHeight"
				Value="50"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TabControl">
					<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="16"
							Padding="{TemplateBinding Padding}"
							SnapsToDevicePixels="False"
							ClipToBounds="False">
						<!-- Evenly distribute headers in one row -->
						<UniformGrid x:Name="HeaderPanel"
									 IsItemsHost="True"
									 Rows="1"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Each pill TAB -->
	<Style x:Key="PillTabItem"
		   TargetType="TabItem">
		<Setter Property="FontFamily"
				Value="{DynamicResource HandTitleFont}"/>
		<Setter Property="FontStyle"
				Value="Italic"/>
		<Setter Property="FontSize"
				Value="18"/>
		<Setter Property="TextOptions.TextFormattingMode"
				Value="Display"/>
		<Setter Property="TextOptions.TextHintingMode"
				Value="Fixed"/>
		<Setter Property="HorizontalAlignment"
				Value="Stretch"/>
		<Setter Property="MinWidth"
				Value="0"/>
		<Setter Property="MinHeight"
				Value="36"/>
		<Setter Property="Margin"
				Value="10,4"/>
		<Setter Property="Padding"
				Value="10,12"/>
		<Setter Property="Background"
				Value="{DynamicResource TabItemBackgroundBrush}"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource TabItemBorderBrush}"/>
		<Setter Property="Foreground"
				Value="{DynamicResource PillTabInactiveTextBrush}"/>
		<Setter Property="FocusVisualStyle"
				Value="{x:Null}"/>
		<Setter Property="HeaderTemplate">
			<Setter.Value>
				<DataTemplate>
					<TextBlock
						Text="{Binding}"
						Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
						FontFamily="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=FontFamily}"
						FontStyle="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=FontStyle}"
						FontSize="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=FontSize}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"/>
				</DataTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TabItem">
					<Border x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="1"
							CornerRadius="12"
							Padding="{TemplateBinding Padding}">
						<ContentPresenter ContentSource="Header"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center"
										  TextElement.Foreground="{TemplateBinding Foreground}"
										  TextElement.FontFamily="{TemplateBinding FontFamily}"
										  TextElement.FontStyle="{TemplateBinding FontStyle}"
										  TextElement.FontSize="{TemplateBinding FontSize}"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter TargetName="Bd"
									Property="Background"
									Value="{DynamicResource TabItemHoverBrush}"/>
						</Trigger>
						<Trigger Property="IsSelected"
								 Value="True">
							<Setter TargetName="Bd"
									Property="Background"
									Value="{DynamicResource TabItemSelectedBrush}"/>
							<Setter Property="Foreground"
									Value="{DynamicResource PillTabSelectedTextBrush}"/>
							<Setter Property="FontWeight"
									Value="SemiBold"/>
						</Trigger>
						<Trigger Property="IsEnabled"
								 Value="False">
							<Setter Property="Opacity"
									Value="0.6"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

	</Style>








	<!-- 1) The template as a standalone resource -->
	<ControlTemplate x:Key="AssignToSwitchTemplate"
					 TargetType="ToggleButton">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>

			<!-- Track spans both columns -->
			<Border x:Name="Track"
					Grid.ColumnSpan="2"
					CornerRadius="16"
					Background="{DynamicResource MeTaskTextBrush}"
					BorderBrush="{DynamicResource CardBorderBrush}"
					BorderThickness="1"/>

			<!-- Labels overlay -->
			<Grid Grid.ColumnSpan="2"
				  Margin="9,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="PartnerLabel"
						   Text="Partner"
						   VerticalAlignment="Center"
						   HorizontalAlignment="Left"
						   Foreground="White"
						   FontWeight="Bold"
						   Opacity="0.95"/>

				<!-- Right = Me -->
				<TextBlock x:Name="MeLabel"
						   Grid.Column="1"
						   Text="Me"
						   VerticalAlignment="Center"
						   HorizontalAlignment="Right"
						   Foreground="White"
						   FontWeight="Bold"
						   Opacity="0.95"/>
			</Grid>

			<!-- Thumb sits in a column we toggle -->
			<Border x:Name="Thumb"
					Grid.Column="0"
					Width="28"
					Height="28"
					CornerRadius="14"
					Background="{DynamicResource ControlBackgroundBrush}"
					BorderBrush="{DynamicResource CardBorderBrush}"
					BorderThickness="1"
					Margin="2"/>
		</Grid>

		<!-- IMPORTANT: Triggers are inside the ControlTemplate owner -->
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver"
					 Value="True">
				<Setter TargetName="Thumb"
						Property="Opacity"
						Value="0.98"/>
				<Setter TargetName="Track"
						Property="Opacity"
						Value="0.98"/>
			</Trigger>
			<Trigger Property="IsPressed"
					 Value="True">
				<Setter TargetName="Thumb"
						Property="Opacity"
						Value="0.9"/>
			</Trigger>
			<!-- Checked = Partner -->
			<Trigger Property="IsChecked"
					 Value="True">
				<Setter TargetName="Track"
						Property="Background"
						Value="{DynamicResource PartnerTaskTextBrush}"/>
				<Setter TargetName="Thumb"
						Property="Grid.Column"
						Value="1"/>
				<Setter TargetName="PartnerLabel"
						Property="Visibility"
						Value="Visible"/>
				<Setter TargetName="MeLabel"
						Property="Visibility"
						Value="Collapsed"/>
			</Trigger>
			<Trigger Property="IsChecked"
					 Value="False">
				<Setter TargetName="PartnerLabel"
						Property="Visibility"
						Value="Collapsed"/>
				<Setter TargetName="MeLabel"
						Property="Visibility"
						Value="Visible"/>
			</Trigger>

			<Trigger Property="IsEnabled"
					 Value="False">
				<Setter Property="Opacity"
						Value="0.6"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>






	<!-- Section header -->
	<Style x:Key="SectionHeader"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource {x:Type TextBlock}}">
		<Setter Property="FontFamily"
				Value="{DynamicResource HandScriptFont}"/>
		<Setter Property="FontSize"
				Value="16"/>
		<Setter Property="FontStyle"
				Value="Italic"/>
		<Setter Property="FontWeight"
				Value="Bold"/>
		<Setter Property="Margin"
				Value="0,0,0,8"/>
	</Style>
	<!-- Generic white card -->
	<Style x:Key="Card"
		   TargetType="Border">
		<Setter Property="Background"
				Value="{DynamicResource CardBackgroundBrush}"/>
		<Setter Property="CornerRadius"
				Value="10"/>
		<Setter Property="Padding"
				Value="12"/>
		<Setter Property="Margin"
				Value="0,0,0,10"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource CardBorderBrush}"/>
		<Setter Property="BorderThickness"
				Value="1"/>
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect BlurRadius="10"
								  ShadowDepth="2"
								  Opacity="0.15"/>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- 2) Style that uses the template -->
	<Style x:Key="AssignToSwitch"
		   TargetType="ToggleButton">
		<Setter Property="Width"
				Value="100"/>
		<Setter Property="Height"
				Value="35"/>
		<Setter Property="Cursor"
				Value="Hand"/>
		<Setter Property="Template"
				Value="{StaticResource AssignToSwitchTemplate}"/>
		<Style.Triggers>
			<!-- If not connected, force to Me -->
			<DataTrigger Binding="{Binding IsPartnerVerified}"
						 Value="False">
				<Setter Property="IsChecked"
						Value="False"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="TaskRowTextStyle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource {x:Type TextBlock}}">
		<!-- default (theme) -->
		<Setter Property="Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
		<!-- override by owner -->
		<Style.Triggers>
			<DataTrigger Binding="{Binding AssignedTo}"
						 Value="Me">
				<Setter Property="Foreground"
						Value="{DynamicResource MeTaskTextBrush}"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding AssignedTo}"
						 Value="Partner">
				<Setter Property="Foreground"
						Value="{DynamicResource PartnerTaskTextBrush}"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<!-- Paper-flat task row button (replaces TaskCardButtonStyle) -->
	<Style x:Key="TaskCardButtonStyle"
		   TargetType="Button">
		<Setter Property="Margin"
				Value="0,4,0,4"/>
		<Setter Property="Background"
				Value="Transparent"/>
		<Setter Property="Padding"
				Value="0"/>
		<Setter Property="BorderThickness"
				Value="0"/>
		<Setter Property="HorizontalContentAlignment"
				Value="Stretch"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid>
						<!-- content -->
						<ContentPresenter/>

						<!-- subtle hover wash -->
						<Border x:Name="Hover"
								Background="{DynamicResource HoverBrush}"
								Opacity="0"
								CornerRadius="4"/>

						<!-- faint ruled divider under each row -->
						<Border VerticalAlignment="Bottom"
								Height="1"
								Background="{DynamicResource NotebookRuleBrush}"
								Opacity="0.55"
								Margin="30,0,0,0"/>
						<!-- start after checkbox column -->
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter TargetName="Hover"
									Property="Opacity"
									Value="0.14"/>
						</Trigger>
						<Trigger Property="IsPressed"
								 Value="True">
							<Setter TargetName="Hover"
									Property="Opacity"
									Value="0.22"/>
						</Trigger>
						<Trigger Property="IsEnabled"
								 Value="False">
							<Setter Property="Opacity"
									Value="0.6"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- Round checkbox for task rows -->
	<Style x:Key="CircleCheckBox"
		   TargetType="CheckBox">
		<Setter Property="Width"
				Value="18"/>
		<Setter Property="Height"
				Value="18"/>
		<Setter Property="VerticalAlignment"
				Value="Center"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<Grid>
						<!-- circular track -->
						<Ellipse x:Name="Circle"
								 Stroke="{DynamicResource ControlBorderBrush}"
								 StrokeThickness="1.2"
								 Fill="{x:Null}"/>

						<!-- check glyph -->
						<Path x:Name="Tick"
							  Data="M 3 9 L 7 13 L 15 5"
							  Stroke="{DynamicResource PrimaryTextBrush}"
							  StrokeThickness="2"
							  StrokeStartLineCap="Round"
							  StrokeEndLineCap="Round"
							  StrokeLineJoin="Round"
							  Opacity="0"/>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter TargetName="Circle"
									Property="Stroke"
									Value="{DynamicResource HoverBrush}"/>
						</Trigger>

						<Trigger Property="IsChecked"
								 Value="True">
							<Setter TargetName="Circle"
									Property="Fill"
									Value="{DynamicResource SuccessButtonBrush}"/>
							<Setter TargetName="Circle"
									Property="Stroke"
									Value="{DynamicResource SuccessButtonBorderBrush}"/>
							<Setter TargetName="Tick"
									Property="Opacity"
									Value="1"/>
							<Setter TargetName="Tick"
									Property="Stroke"
									Value="White"/>
						</Trigger>

						<Trigger Property="IsEnabled"
								 Value="False">
							<Setter Property="Opacity"
									Value="0.6"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- Larger, handwritten row title (keeps Me/Partner coloring from TaskRowTextStyle) -->
	<Style x:Key="TaskTitleTextStyle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource TaskRowTextStyle}">
		<Setter Property="FontFamily"
				Value="{DynamicResource HandScriptFont}"/>
		<Setter Property="FontSize"
				Value="18"/>
		<Setter Property="FontWeight"
				Value="Normal"/>
		<Setter Property="TextOptions.TextFormattingMode"
				Value="Display"/>
		<Setter Property="TextOptions.TextHintingMode"
				Value="Fixed"/>
		<Setter Property="LineStackingStrategy"
				Value="BlockLineHeight"/>
		<Setter Property="LineHeight"
				Value="18"/>
	</Style>
	<!-- Smaller, tighter category line -->
	<Style x:Key="TaskCategoryTextStyle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource TaskRowTextStyle}">
		<Setter Property="FontFamily"
				Value="{DynamicResource HandScriptFont}"/>
		<Setter Property="FontSize"
				Value="11"/>
		<Setter Property="FontStyle"
				Value="Italic"/>
		<Setter Property="Opacity"
				Value="0.9"/>
		<!-- pull upward slightly -->
		<Setter Property="Margin"
				Value="0,-4,0,0"/>
		<Setter Property="TextTrimming"
				Value="CharacterEllipsis"/>
	</Style>
	<!-- NEW: Due date in handwritten style -->
	<Style x:Key="TaskDueTextStyle"
		   TargetType="TextBlock"
		   BasedOn="{StaticResource TaskRowTextStyle}">
		<Setter Property="FontFamily"
				Value="{DynamicResource HandScriptFont}"/>
		<Setter Property="FontSize"
				Value="14"/>
		<Setter Property="FontStyle"
				Value="Italic"/>
		<Setter Property="TextOptions.TextFormattingMode"
				Value="Display"/>
		<Setter Property="TextOptions.TextHintingMode"
				Value="Fixed"/>
	</Style>

	<Style TargetType="{x:Type Control}">
		<Setter Property="Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
	</Style>
	<Style TargetType="GroupBox">
		<Setter Property="Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
	</Style>
	<Style TargetType="CheckBox">
		<Setter Property="Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
	</Style>
	<Style TargetType="Button">
		<Setter Property="Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
	</Style>
	<Style TargetType="TextBlock">
		<Setter Property="Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
	</Style>
	<Style TargetType="TextBox"
		   BasedOn="{StaticResource {x:Type TextBox}}">
		<Setter Property="Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="Background"
				Value="{DynamicResource ControlBackgroundBrush}"/>
		<Setter Property="Margin"
				Value="5"/>
		<Setter Property="Padding"
				Value="5"/>
		<Setter Property="FontSize"
				Value="14"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource ControlBorderBrush}"/>
		<Setter Property="BorderThickness"
				Value="1"/>
		<Setter Property="Height"
				Value="28"/>
	</Style>

	<Style TargetType="ComboBox"
		   BasedOn="{StaticResource {x:Type ComboBox}}">
		<Setter Property="Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="Background"
				Value="{DynamicResource ControlBackgroundBrush}"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource ControlBorderBrush}"/>
		<Setter Property="Padding"
				Value="4"/>
		<Setter Property="Height"
				Value="28"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<!-- the box you see when it's closed -->
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="4"/>

						<!-- content -->
						<ContentPresenter Margin="8,0,28,0"
										  VerticalAlignment="Center"
										  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding SelectionBoxItem}"
										  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
										  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
										  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
										  RecognizesAccessKey="True"
										  TextElement.Foreground="{TemplateBinding Foreground}"/>

						<!-- dropdown button -->
						<ToggleButton Grid.Column="1"
									  Focusable="False"
									  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
									  ClickMode="Press"
									  Background="{TemplateBinding Background}"
									  BorderBrush="{TemplateBinding BorderBrush}"
									  BorderThickness="0"
									  HorizontalAlignment="Right"
									  Width="22"
									  Padding="0">
							<Path Data="M 0 0 L 5 5 L 10 0 Z"
								  Width="10"
								  Height="6"
								  Stretch="Uniform"
								  Margin="0,0,0,2"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Fill="{DynamicResource PrimaryTextBrush}"/>
						</ToggleButton>

						<!-- popup -->
						<Popup x:Name="Popup"
							   Placement="Bottom"
							   IsOpen="{TemplateBinding IsDropDownOpen}"
							   AllowsTransparency="True"
							   Focusable="False"
							   PopupAnimation="Slide">
							<Border Background="{DynamicResource ControlBackgroundBrush}"
									BorderBrush="{DynamicResource ControlBorderBrush}"
									BorderThickness="1"
									SnapsToDevicePixels="True"
									MaxHeight="{TemplateBinding MaxDropDownHeight}"
									MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
								<!-- key line -->
								<ScrollViewer>
									<ItemsPresenter/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter TargetName="Bd"
									Property="BorderBrush"
									Value="{DynamicResource HoverBrush}"/>
						</Trigger>
						<Trigger Property="IsKeyboardFocusWithin"
								 Value="True">
							<Setter TargetName="Bd"
									Property="BorderBrush"
									Value="{DynamicResource PressedBrush}"/>
						</Trigger>
						<Trigger Property="IsEnabled"
								 Value="False">
							<Setter Property="Opacity"
									Value="0.6"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
