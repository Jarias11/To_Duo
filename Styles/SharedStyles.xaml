	<!-- === Bulletin Board Expander (header unchanged, content shows on cork) === -->
	<Style x:Key="BulletinExpander"
		   TargetType="Expander">
		<Setter Property="IsExpanded"
				Value="True"/>
		<Setter Property="Margin"
				Value="0,0,0,10"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Expander">
					<Grid>
						<!-- Wooden frame with shadow -->
						<Border x:Name="Frame"
								Background="{DynamicResource BulletinFrameBrush}"
								CornerRadius="12">
							<Border.Effect>
								<DropShadowEffect BlurRadius="14"
												  ShadowDepth="2"
												  Opacity="0.22"/>
							</Border.Effect>
						</Border>

						<!-- Cork surface inside frame -->
						<Border x:Name="Board"
								Margin="6,6,6,12"
								Background="{DynamicResource BulletinBoardBrush}"
								CornerRadius="10"
								BorderBrush="#8C6A3D"
								BorderThickness="1"/>

						<!-- Subtle bevel/highlight on the cork -->
						<Border Margin="6,6,6,12"
								CornerRadius="10"
								BorderBrush="{DynamicResource BulletinBevelBrush}"
								BorderThickness="1"
								Background="{x:Null}"/>

						<!-- Header + Body laid over the board -->
						<Grid Margin="18,12,18,14">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<!-- Header row (full row clickable) -->
							<ToggleButton x:Name="HeaderSite"
										  Content="{TemplateBinding Header}"
										  Focusable="False"
										  FocusVisualStyle="{x:Null}"
										  HorizontalContentAlignment="Left"
										  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
										  OverridesDefaultStyle="True">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border x:Name="HeaderBg"
												Background="Transparent"
												Padding="12,6"
												BorderThickness="0"
												CornerRadius="10">
											<ContentPresenter VerticalAlignment="Center"/>
										</Border>
										<!-- Order matters: put IsChecked last so it wins -->
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver"
													 Value="True">
												<Setter TargetName="HeaderBg"
														Property="Background"
														Value="Transparent"/>
											</Trigger>
											<Trigger Property="IsPressed"
													 Value="True">
												<Setter TargetName="HeaderBg"
														Property="Background"
														Value="Transparent"/>
											</Trigger>
											<Trigger Property="IsChecked"
													 Value="True">
												<Setter TargetName="HeaderBg"
														Property="Background"
														Value="Transparent"/>
											</Trigger>

										</ControlTemplate.Triggers>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>

							<!-- Expander body -->
							<ContentPresenter x:Name="ExpandSite"
											  Grid.Row="1"
											  Margin="0,10,0,0"
											  Visibility="Collapsed"/>
						</Grid>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger SourceName="HeaderSite"
								 Property="IsChecked"
								 Value="True">
							<Setter TargetName="ExpandSite"
									Property="Visibility"
									Value="Visible"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- Pushpin popout button -->
	<Style x:Key="PushpinButton"
		   TargetType="Button">
		<Setter Property="Width"
				Value="26"/>
		<Setter Property="Height"
				Value="26"/>
		<Setter Property="Padding"
				Value="0"/>
		<Setter Property="Background"
				Value="Transparent"/>
		<Setter Property="BorderThickness"
				Value="0"/>
		<Setter Property="Cursor"
				Value="Hand"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid>
						<!-- rotate a little so it looks pinned -->
						<Grid RenderTransformOrigin="0.5,0.1">
							<Grid.RenderTransform>
								<RotateTransform Angle="-15"/>
							</Grid.RenderTransform>

							<!-- scale group for hover/press -->
							<Grid x:Name="PinScale"
								  RenderTransformOrigin="0.5,0.1">
								<Grid.RenderTransform>
									<ScaleTransform ScaleX="1"
													ScaleY="1"/>
								</Grid.RenderTransform>

								<!-- needle (behind) -->
								<Path x:Name="Needle"
									  Data="M 0,0 L 0,12"
									  Stroke="{DynamicResource PushpinNeedleBrush}"
									  StrokeThickness="1.6"
									  StrokeStartLineCap="Round"
									  StrokeEndLineCap="Round"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Top"
									  Margin="0,14,0,0"
									  Panel.ZIndex="0"/>

								<!-- head (in front) -->
								<Ellipse x:Name="Head"
										 Width="16"
										 Height="16"
										 Fill="{DynamicResource PushpinHeadBrush}"
										 Stroke="{DynamicResource PushpinHeadStrokeBrush}"
										 StrokeThickness="1"
										 Panel.ZIndex="1">
									<Ellipse.Effect>
										<DropShadowEffect BlurRadius="6"
														  ShadowDepth="2"
														  Opacity="0.35"/>
									</Ellipse.Effect>
								</Ellipse>
							</Grid>
						</Grid>
					</Grid>

					<ControlTemplate.Triggers>

						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter TargetName="PinScale"
									Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleX="1.08"
													ScaleY="1.08"/>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger Property="IsPressed"
								 Value="True">
							<Setter TargetName="PinScale"
									Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleX="0.95"
													ScaleY="0.95"/>
								</Setter.Value>
							</Setter>
						</Trigger>

						<Trigger Property="IsEnabled"
								 Value="False">
							<Setter Property="Opacity"
									Value="0.6"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- === Connections helpers (theme-safe) ================================= -->

	<!-- Read-only code display with subtle chip chrome -->
	<Style x:Key="CodeDisplayTextBox"
		   TargetType="TextBox"
		   BasedOn="{StaticResource {x:Type TextBox}}">
		<Setter Property="IsReadOnly"
				Value="True"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource TopBarChipBorderBrush}"/>
		<Setter Property="Background"
				Value="{DynamicResource TopBarChipBackgroundBrush}"/>
		<Setter Property="FontFamily"
				Value="Consolas, Cascadia Mono, Segoe UI"/>
		<Setter Property="FontWeight"
				Value="SemiBold"/>
		<Setter Property="Padding"
				Value="6,2"/>
		<Setter Property="Height"
				Value="28"/>
		<Setter Property="BorderThickness"
				Value="1"/>
		<Setter Property="Cursor"
				Value="Arrow"/>
		<Setter Property="IsReadOnlyCaretVisible"
				Value="False"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6"
							Padding="{TemplateBinding Padding}">
						<ScrollViewer x:Name="PART_ContentHost"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Generic “info” chip -->
	<Style x:Key="InfoChip"
		   TargetType="Border">
		<Setter Property="CornerRadius"
				Value="12"/>
		<Setter Property="Padding"
				Value="8,4"/>
		<Setter Property="Background"
				Value="{DynamicResource TopBarChipBackgroundBrush}"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource TopBarChipBorderBrush}"/>
		<Setter Property="BorderThickness"
				Value="1"/>
		<Setter Property="VerticalAlignment"
				Value="Center"/>

		<!-- Let any text inside inherit the handwritten look -->
		<Setter Property="TextElement.FontFamily"
				Value="{DynamicResource HandScriptFont}"/>
		<Setter Property="TextElement.Foreground"
				Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="TextElement.FontSize"
				Value="14"/>
	</Style>

	<!-- Pending status chip (blue-ish) -->
	<Style x:Key="PendingChip"
		   TargetType="Border"
		   BasedOn="{StaticResource InfoChip}">
		<Setter Property="Background"
				Value="{DynamicResource PendingChipBackgroundBrush}"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource PendingChipBorderBrush}"/>
	</Style>

	<!-- Small “waiting/cancel” container -->
	<Style x:Key="PendingInfoCard"
		   TargetType="Border"
		   BasedOn="{StaticResource Card}">
		<Setter Property="Padding"
				Value="10"/>
		<Setter Property="Margin"
				Value="0"/>
		<Setter Property="Background"
				Value="{DynamicResource ActivityCardBackgroundBrush}"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource CardBorderBrush}"/>
	</Style>

	<!-- Decline/Disconnect pill that complements SuccessButton -->
	<Style x:Key="DeclinePillButton"
		   TargetType="Button">
		<Setter Property="Foreground"
				Value="{DynamicResource DeclinePillForegroundBrush}"/>
		<Setter Property="Background"
				Value="{DynamicResource DeclinePillBackgroundBrush}"/>
		<Setter Property="BorderBrush"
				Value="{DynamicResource DeclinePillBorderBrush}"/>
		<Setter Property="BorderThickness"
				Value="1"/>
		<Setter Property="Padding"
				Value="12,6"/>
		<Setter Property="MinWidth"
				Value="90"/>
		<Setter Property="Height"
				Value="32"/>
		<Setter Property="Cursor"
				Value="Hand"/>
		<Setter Property="FontFamily"
				Value="{DynamicResource HandScriptFont}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Bd"
							CornerRadius="10"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter TargetName="Bd"
									Property="Opacity"
									Value="0.95"/>
						</Trigger>
						<Trigger Property="IsPressed"
								 Value="True">
							<Setter TargetName="Bd"
									Property="Opacity"
									Value="0.9"/>
						</Trigger>
						<Trigger Property="IsEnabled"
								 Value="False">
							<Setter TargetName="Bd"
									Property="Opacity"
									Value="0.6"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>



</ResourceDictionary>